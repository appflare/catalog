{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "mail2telegram",
  "name": "mail2telegram",
  "summary": "Receive your domain's email in Telegram: a push for every message and a Mini App inbox with attachments, filters, and AI summaries.",
  "homepage": "https://github.com/TBXark/mail2telegram",
  "repo": "TBXark/mail2telegram",
  "license": "MIT",
  "categories": ["email", "bots"],
  "maintainers": ["MendyLanda"],
  // Upstream tags releases without a "v" prefix (2.0.0); the packer reads both forms.
  "source": { "ref": "2.0.0", "sha": "39234192b14404b25d6401272de7ebb0e29ce1bb" },
  "install": {
    "tier": "artifact",
    "packageManager": "pnpm",
    "wranglerConfig": "wrangler.jsonc",
    "workerName": "mail2telegram",
    // The wrangler config serves the Mini App from packages/web/dist/client but
    // has no build.command; upstream's deploy script builds it with this.
    "buildCommand": "pnpm --filter @mail2telegram/web build",
    // Runs Worker code (the assets config sends /api/* to the Worker first) and
    // needs no credentials: it only reports whether password sign-in is on.
    // The Worker also checks the D1 schema on the first request of an isolate.
    "healthPath": "/api/auth",
    // Every address of the chosen zone that no other rule matches goes to the
    // Worker's email handler, as upstream's deployment guide sets it up.
    "emailRouting": { "catchAll": true }
  },
  // Receiving mail, D1, R2, and Workers AI all fit the free plan. Upstream notes
  // that parsing costs about 2 ms of CPU per MB of mail, so on the free plan's
  // 10 ms budget keep Max Size in the Mini App's Mail Handling settings under
  // about 2 MB.
  "plan": "free",
  // Workers AI is one of two summary backends and summaries are off by default,
  // so it is not a requirement.
  "requires": ["zone", "email-routing", "r2"],
  // RESEND_API_KEY (replies through Resend) and OPENAI_API_KEY (the other
  // summary backend) are optional in upstream, and every secret here must have
  // a value, so they are left out: add them later as secrets in the Worker's
  // settings, where updates keep them.
  "secrets": [
    {
      "name": "TELEGRAM_TOKEN",
      "label": "Telegram bot token",
      "help": "Send /newbot to @BotFather in Telegram and paste the token it replies with. One Worker serves one bot."
    },
    {
      "name": "WEB_PASSWORD",
      "label": "Web password",
      "help": "Opens the Mini App in a plain browser, outside Telegram. Inside Telegram no password is needed. Copy it now.",
      "generate": true
    }
  ],
  "vars": [
    {
      "name": "TELEGRAM_ID",
      "label": "Telegram chat ids",
      "help": "Where mail is pushed, comma separated: your numeric user id from @userinfobot, or a group id starting with -100. Only these chats can open the Mini App.",
      "required": true
    },
    {
      "name": "DOMAIN",
      "label": "Mini App host",
      "help": "Only to serve the Mini App from another host, for example mail.example.com. Leave empty: the Worker learns its own host when you open /init.",
      "required": false
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{workerUrl}}/init once. It registers the Telegram webhook and points the bot's menu button at the Mini App. Then send `/start` to the bot."
    },
    {
      "type": "markdown",
      "content": "Every address of the zone you picked that has no other routing rule now reaches the bot. Send a test mail to any address there; it arrives as a Telegram message with Preview, Summary, and Open buttons."
    },
    {
      "type": "markdown",
      "content": "Settings live in the Mini App: allow and block lists, forwarding to a backup address (which must be verified under Email Routing, Destination addresses), mail size limits, and AI summaries with Workers AI or an OpenAI-compatible provider. To reply to mail from Telegram, add a Resend API key as the secret `RESEND_API_KEY` in the Worker's settings."
    }
  ],
  "tokenPermissions": [],
  // No auto-merge: upstream tags rarely and its last release (1.0 to 2.0) changed
  // binding types and needed a migration guide, so each bump gets a human review.
  "bump": { "autoMerge": false }
}
