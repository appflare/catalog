{
  // A shop for digital goods such as licence keys and gift cards, in one Vike
  // app on a Worker with D1: a storefront, an admin panel, and automatic
  // delivery of card keys once an order is paid.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "edgekey",
  "name": "EdgeKey",
  "summary": "A shop for digital goods: sell card keys and codes, take payment through USDT, Epay, Alipay or Stripe, and deliver each order automatically by page and email.",
  "tagline": "Sell digital codes and deliver them automatically after payment",
  "homepage": "https://shop.v50.app",
  "repo": "34892002/edgeKey",
  "license": "MIT",
  "categories": ["business", "ecommerce"],
  // openPath and field links added after this release was published: a revision,
  // no new build.
  "revision": 3,
  "authors": [{ "name": "ggyy", "github": "34892002" }],
  "maintainers": ["MendyLanda"],
  // No release tags upstream; the pin tracks main.
  "source": { "ref": "main", "sha": "fa69913b89a3dbd916be931fb4e06a0ae80958f4" },
  "install": {
    "packageManager": "bun",
    // Vike with Photon builds through the Cloudflare Vite plugin, which writes
    // the deployable config under dist/ and points wrangler at it.
    "wranglerConfig": "wrangler.jsonc",
    // Generates the Prisma client for D1, then builds the Vike app.
    "buildCommand": "bun run build"
  },
  // Workers, D1 and one cron trigger (closing expired orders every five
  // minutes) fit the free plan.
  "plan": "free",
  "secrets": [
    {
      "name": "AUTH_SECRET",
      "label": "Session secret",
      "help": "Signs admin sign-in sessions. Setting a new value signs every admin out.",
      "generate": "password"
    },
    {
      "name": "EDGEKEY_ADMIN_PASSWORD",
      "label": "Admin password",
      "help": "The password of the admin account `admin`.",
      "generate": "password",
      "seedOnly": true
    },
    {
      "name": "TURNSTILE_SITE_KEY",
      "label": "Turnstile site key",
      "help": "With the secret key below, puts a Cloudflare Turnstile check on the admin sign-in page. Set both or neither.",
      "link": {
        "label": "Create a widget",
        "url": "https://dash.cloudflare.com/?to=/:account/turnstile"
      },
      "optional": true
    },
    {
      "name": "TURNSTILE_SECRET_KEY",
      "label": "Turnstile secret key",
      "help": "The secret key of the same Turnstile widget.",
      "link": {
        "label": "Create a widget",
        "url": "https://dash.cloudflare.com/?to=/:account/turnstile"
      },
      "optional": true
    }
  ],
  "openPath": "/admin",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/admin and sign in as `admin` with the admin password from the install form (Appflare does not keep it). Then set the site name, payment channels and email delivery in the admin panel; upstream's docs/pay folder explains each payment provider."
    }
  ],
  "resources": {
    "d1": {
      "DB": {
        // The wrangler config's prisma/migrations folder holds the tables. The
        // seed file adds the site settings, the email templates and a default
        // admin, each only when missing, as upstream's deploy script runs it
        // on every deploy.
        "schema": ["scripts/seed.sql"],
        // Claims the user name `admin` before scripts/seed.sql runs, so its
        // default admin (the password published in upstream's README) is
        // skipped on install and on every update: its INSERT ends in
        // ON CONFLICT("username") DO NOTHING (scripts/seed.sql:7-9), and
        // prisma/migrations/0001_init.sql:197 makes username unique. Sign-in
        // (server/authjs-handler.ts:111-120) needs status ACTIVE and checks
        // the hash with verifyAdminPassword (modules/auth/crypto.ts:8-15):
        // bcryptjs 3 compare for $2a$/$2b$ hashes. Upstream hashes with
        // bcrypt cost 10 (modules/auth/crypto.ts:4-6); the seed does the same.
        "seed": {
          "hashes": {
            "admin": { "from": "EDGEKEY_ADMIN_PASSWORD", "method": "bcrypt", "cost": 10 }
          },
          "statements": [
            {
              "sql": "INSERT INTO \"Admin\" (\"username\", \"passwordHash\", \"nickname\", \"status\", \"updatedAt\") VALUES ('admin', ?, '管理员', 'ACTIVE', CURRENT_TIMESTAMP) ON CONFLICT(\"username\") DO NOTHING",
              "params": [{ "hash": "admin" }]
            }
          ],
          "beforeSchema": true
        }
      }
    }
  }
}
