{
  // An IP and network diagnostics site: look up any address (location,
  // ASN, reputation and risk), check your own exit address, DNS, CDN,
  // WebRTC leaks and browser fingerprint, run a speed test, and see the
  // status of AI services. A React app served by one Worker that calls
  // public lookup APIs; it stores nothing.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "one-ip",
  "name": "One IP",
  "summary": "IP and network diagnostics: look up an address's location, ASN, reputation and risk, check your exit IP, DNS, CDN, WebRTC and browser fingerprint, and run a speed test.",
  "homepage": "https://ip.huzhihui.com",
  "repo": "zhihui-hu/one-ip",
  "license": "AGPL-3.0-only",
  "categories": ["networking", "utilities"],
  "authors": [{ "name": "Hu Zhihui", "url": "https://huzhihui.com", "github": "zhihui-hu" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags, so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "3d6531437cd1bf5e03711339c7d96b674d3e1e16" },
  "install": {
    "tier": "artifact",
    "packageManager": "pnpm",
    // The Worker is plain JavaScript in public/worker/; the build is the
    // React app it serves from dist/. The config's local environment is only
    // for development and is not read.
    "wranglerConfig": "wrangler.toml",
    "workerName": "one-ip",
    // Upstream's build script (tsc -b, then vite build), as its deploy
    // guide says.
    "buildCommand": "pnpm run build",
    // Answers from the Worker's own code without calling any outside lookup
    // service (/ is the static app).
    "healthPath": "/api/map/config"
  },
  // Workers and two rate limits (per-client API and action limits) fit the
  // free plan. No storage and no cron triggers.
  "plan": "free",
  "requires": [],
  // All optional. The verification page demonstrates a CAPTCHA provider
  // only when its site key, secret and hostname are all set; the map uses
  // OpenStreetMap unless a Tianditu token is set.
  "secrets": [
    {
      "name": "TURNSTILE_SECRET",
      "label": "Turnstile secret key",
      "help": "Optional. The secret key of a Cloudflare Turnstile widget, for the verification page. Needs the site key and hostnames below too.",
      "optional": true
    },
    {
      "name": "TURNSTILE_NONINTERACTIVE_SECRET",
      "label": "Non-interactive Turnstile secret key",
      "help": "Optional. The secret key of a second Turnstile widget in Non-interactive mode. Needs its site key and hostnames below too.",
      "optional": true
    },
    {
      "name": "RECAPTCHA_SECRET",
      "label": "reCAPTCHA v3 secret key",
      "help": "Optional. The secret key of a Google reCAPTCHA v3 site, for the verification page. Needs the site key and hostnames below too.",
      "optional": true
    },
    {
      "name": "TIANDITU_TOKEN",
      "label": "Tianditu map token",
      "help": "Optional. A Tianditu browser token, for maps that load in mainland China. Without it the map uses OpenStreetMap. The token is handed to the browser.",
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "TURNSTILE_SITE_KEY",
      "label": "Turnstile site key",
      "help": "Optional. The site key of the Turnstile widget.",
      "default": "",
      "required": false
    },
    {
      "name": "TURNSTILE_HOSTNAMES",
      "label": "Turnstile hostnames",
      "help": "Optional. The hostnames the Turnstile widget is shown on, comma-separated, for example this app's workers.dev host name.",
      "default": "",
      "required": false
    },
    {
      "name": "TURNSTILE_NONINTERACTIVE_SITE_KEY",
      "label": "Non-interactive Turnstile site key",
      "help": "Optional. The site key of the Non-interactive Turnstile widget.",
      "default": "",
      "required": false
    },
    {
      "name": "TURNSTILE_NONINTERACTIVE_HOSTNAMES",
      "label": "Non-interactive Turnstile hostnames",
      "help": "Optional. The hostnames the Non-interactive widget is shown on, comma-separated.",
      "default": "",
      "required": false
    },
    {
      "name": "RECAPTCHA_SITE_KEY",
      "label": "reCAPTCHA v3 site key",
      "help": "Optional. The site key of the reCAPTCHA v3 site.",
      "default": "",
      "required": false
    },
    {
      "name": "RECAPTCHA_HOSTNAMES",
      "label": "reCAPTCHA hostnames",
      "help": "Optional. The hostnames reCAPTCHA is shown on, comma-separated.",
      "default": "",
      "required": false
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{workerUrl}} to see your own connection. From a terminal, `curl -fsS '{{workerUrl}}/api/ip/health?format=text'` prints your exit address with its trust score; add `ip=1.1.1.1` to check another address."
    }
  ],
  "tokenPermissions": []
}
