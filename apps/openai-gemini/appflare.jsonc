{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "openai-gemini",
  "name": "OpenAI Gemini",
  "summary": "Use Gemini with OpenAI clients through your own API endpoint, with chat, embeddings, streaming replies, tool calls, and image or audio input.",
  "tagline": "Use Gemini in apps built for OpenAI",
  "homepage": "https://my-openai-gemini-demo.vercel.app/",
  "repo": "PublicAffairs/openai-gemini",
  "license": "MIT",
  "categories": ["ai", "developer-tools"],
  // The formatting of URLs in the notes changed after this release was published:
  // a revision, no new build.
  "revision": 3,
  "authors": [{ "name": "PublicAffairs", "github": "PublicAffairs" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no semver release tags (its tags name Gemini models); the pin tracks main.
  "source": { "ref": "main", "sha": "61a83bd9d0def59811624b6ae7d8213a231185d0" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml",
    // "/" answers 404. A GET here is rejected with 400 by the Worker itself,
    // before any call to Google, so it needs no API key and no network.
    "health": { "path": "/v1/chat/completions" }
  },
  "plan": "free",
  // Callers send their own Gemini API key as the bearer token; the Worker stores none.
  "secrets": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Point an OpenAI client at `{{appUrl}}/v1` and use your Gemini API key from Google AI Studio as the API key."
    }
  ]
}
