{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "fxtiktok",
  "name": "fxTikTok",
  "summary": "Fixes TikTok embeds on Discord and other chat apps: swap tiktok.com for your own address in a link and it previews the video or slideshow inline, with the author, caption and counts.",
  "tagline": "Make TikTok links preview videos and slideshows in chat",
  "features": [
    "Play linked TikTok videos inside Discord",
    "Preview multi-image TikTok slideshows",
    "Show captions above video previews",
    "Share direct video or image links without counts",
    "Request higher quality video playback"
  ],
  "homepage": "https://tnktok.com",
  "repo": "okdargy/fxTikTok",
  // GitHub does not detect the licence, but the LICENSE file is the MIT licence.
  "license": "MIT",
  "categories": ["media", "utilities"],
  // The formatting of URLs in the notes changed after this release was published:
  // a revision, no new build.
  // Features added in revision 3.
  "revision": 3,
  "authors": [{ "name": "dargy", "url": "https://dar.gy", "github": "okdargy", "x": "okdargy" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin is the head of its default branch,
  // hono-rewrite.
  "source": { "ref": "hono-rewrite", "sha": "5c3e70b0abb549dda2b034c09533fc4565674eba" },
  "install": {
    // package.json pins pnpm, but upstream commits no lockfile, so the packer
    // resolves package.json's ranges at pack time; the pack log records the
    // sha256 of the pnpm-lock.yaml it wrote
    // (hono-rewrite@66fbae3, 2026-09-27: f5c902c92cd28b0dc7cc8bc327f4b1004eef3e686d00dcd276d04b5887535fcb).
    "packageManager": "pnpm",
    "installDirs": [{ "path": ".", "lockfile": "none" }],
    "wranglerConfig": "wrangler.toml",
    // / redirects to the GitHub repository; the favicon answers 204 from the
    // Worker itself.
    "health": { "path": "/favicon.ico" }
  },
  // One Worker without storage. Video and images stream through it.
  "plan": "free",
  // WORKER_ENV keeps upstream's "production".
  "vars": [
    {
      "name": "OFF_LOAD",
      "label": "Media address",
      "help": "Where embeds load videos, images and avatars from. The Worker serves them itself; upstream points this at its own offload.tnktok.com.",
      "default": "{{appUrl}}"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Replace `https://www.tiktok.com` in a TikTok link with `{{appUrl}}`, for example `{{appUrl}}/@user/video/<id>`, and chat apps show the video in the preview. Add `?isDirect=true` for the media file itself, or `?hq=true` for the higher quality video."
    }
  ]
}
