{
  // The blobatar avatar endpoint on its own Worker: GET /avatar/<name> renders
  // the same geometric SVG avatar for the same string every time. No storage
  // and no bindings; the repository's other apps (the blobatar.dev site, the
  // demos) are not installed.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "blobatar",
  "name": "blobatar API",
  "summary": "Your own avatar endpoint: GET /avatar/<name> returns a deterministic geometric blobatar SVG for any username, email or id, with Gravatar-compatible URLs.",
  "tagline": "Generate an avatar for any name or email address",
  "features": [
    "Get the same avatar every time for the same username, email or ID",
    "Embed avatars in your website with an image URL",
    "Choose the avatar size, colors, background and expression",
    "Reuse Gravatar-style URLs by changing the host",
    "Keep the original avatar style with a generation setting"
  ],
  "alternativeTo": ["Gravatar"],
  "homepage": "https://blobatar.dev",
  "repo": "Alain00/blobatar",
  "license": "MIT",
  "categories": ["developer-tools", "utilities"],
  // The formatting of URLs in the notes changed after this release was published:
  // a revision, no new build.
  // Features and alternatives (revision 3).
  "revision": 3,
  "authors": [{ "name": "Alain", "url": "https://blobatar.dev", "github": "Alain00" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v2.7.0", "sha": "ebb7ea4808b1263629fc8fa65e2398b9cbdb6f6b" },
  "install": {
    "packageManager": "bun",
    // The endpoint is apps/api of a bun workspace, and it imports the blobatar
    // library of the same workspace. The root bun.lock at this tag still
    // records the workspace packages at 2.6.0, so a frozen install refuses it.
    // apps/api ships no lockfile of its own; installing there resolves the
    // whole workspace from the root lockfile, and only those version fields
    // (and the @types/bun that "latest" names) move. The pack log records
    // the resulting lockfile's hash.
    "installDirs": [{ "path": "apps/api", "lockfile": "none" }],
    // The endpoint resolves the library through its package exports, which
    // point at built files the repository does not hold.
    "buildCommand": "bun --filter blobatar build",
    "wranglerConfig": "apps/api/wrangler.jsonc",
    "workerName": "blobatar-api"
  },
  // One stateless Worker; each avatar renders in microseconds, and responses
  // carry long cache headers.
  "plan": "free",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Point avatar URLs at `{{appUrl}}/avatar/<name>`, for example `<img src=\"{{appUrl}}/avatar/alice?size=64\">`. {{appUrl}}/avatar/ lists every parameter, and {{appUrl}}/openapi.json describes the endpoint. To serve a Gravatar URL, keep its path and query and change only the host."
    }
  ]
}
