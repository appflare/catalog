{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "nodecrypt",
  "name": "NodeCrypt",
  "summary": "End-to-end encrypted chat rooms in the browser: no accounts and no stored history, with private messages, images, and files, relayed by a Durable Object that never sees plaintext.",
  "tagline": "Private chat rooms without accounts or message history",
  "features": [
    "Join encrypted group conversations in your browser",
    "Start a private conversation with one room member",
    "Share images and files in the chat",
    "Protect a room with a password",
    "Join rooms without creating an account",
    "Keep no message history, so people who join later cannot read earlier messages"
  ],
  "homepage": "https://nodecrypt.shuaiplus.workers.dev/",
  "repo": "shuaiplus/nodecrypt",
  "license": "ISC",
  "categories": ["chat", "privacy"],
  "revision": 3,
  "authors": [{ "name": "Shuai", "url": "https://shuai.plus", "github": "shuaiplus" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin tracks main.
  "source": { "ref": "main", "sha": "54ed04903182799895e98af365cf4172f7b2f3f3" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml",
    // The config serves dist but has no build.command; upstream's deploy steps
    // build the web client with this (Vite).
    "buildCommand": "npm run build"
  },
  // One SQLite-backed Durable Object class; rooms live in memory only.
  "plan": "free",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}, pick a name, a room name, and an optional room password, and share the room name and password with the people you want to talk to. The password is part of the encryption key, so a wrong one cannot read the room."
    },
    {
      "type": "markdown",
      "content": "Nothing is stored: messages pass through the Worker encrypted and only in memory, so people who join later see no earlier messages."
    }
  ]
}
