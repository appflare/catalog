{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "usage-guard-collector",
  "name": "Usage Guard Collector",
  "summary": "Usage surge alerts for your Cloudflare account: reads daily Workers, D1, Durable Objects, KV, R2 and Queues counts into D1 and pings Discord or Slack when a meter jumps.",
  "tagline": "Get alerts when your Cloudflare usage suddenly jumps",
  "repo": "HowardZlh/usage-guard-collector",
  "license": "MIT",
  "categories": ["monitoring", "utilities"],
  // Field links added after this release was published: a revision, no new build.
  "revision": 3,
  "authors": [{ "name": "Howard", "url": "https://guushu.com", "github": "HowardZlh" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin tracks the default branch, main.
  "source": { "ref": "main", "sha": "f9809bb41ba54beaa668c5eadb3d33c3875b99f0" },
  "install": {
    "packageManager": "pnpm",
    "wranglerConfig": "wrangler.jsonc"
  },
  // One cron every 6 hours, two GraphQL requests a run and a few dozen D1
  // rows: well inside the free plan.
  "plan": "free",
  // The status page (GET /, the only route: src/index.ts) has no sign-in and
  // shows the account's usage, so protection starts switched on. The cron is
  // not a request, so Access does not stand in its way.
  "access": { "mode": "recommended" },
  // Seeded from upstream's .dev.vars.example and the webhooks its wrangler
  // config names as optional. Upstream asks for CF_ACCOUNT_ID as a secret;
  // it is not secret, so here it is a var filled in with this account's id.
  "secrets": [
    {
      "name": "CF_API_TOKEN",
      "label": "Analytics API token",
      "help": "A Cloudflare API token with Account Analytics Read on this account and nothing else. The Worker reads usage through the GraphQL Analytics API with it and never logs it.",
      "cloudflareToken": true
    },
    {
      "name": "DISCORD_WEBHOOK_URL",
      "label": "Discord webhook URL",
      "help": "Where surge alerts are posted in Discord. Without a webhook, surges show only on the status page.",
      "link": {
        "label": "Create a webhook",
        "url": "https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks"
      },
      "optional": true
    },
    {
      "name": "SLACK_WEBHOOK_URL",
      "label": "Slack webhook URL",
      "help": "Where surge alerts are posted in Slack (an incoming webhook).",
      "link": {
        "label": "Create a webhook",
        "url": "https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks/"
      },
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "CF_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "help": "The account whose usage is watched: this one. Filled in on every install and update.",
      "default": "{{accountId}}"
    },
    {
      "name": "THRESHOLDS_JSON",
      "label": "Alert floors",
      "help": "Optional JSON object of per-metric minimums a surge must reach, for example {\"d1.rows_read\": 5000000}. Metric names are those on the status page. Leave empty for upstream's defaults.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "The first collection runs at the next 00:00, 06:00, 12:00 or 18:00 UTC; open {{appUrl}} afterwards for the last 7 days of usage and the current surges. The first day flags nothing, since there is no baseline yet."
    },
    {
      "type": "markdown",
      "content": "The status page has no sign-in of its own. Behind Cloudflare Access only Appflare's users see it; without it, anyone with the address can see your usage table. The cron runs either way."
    }
  ],
  "tokenPermissions": [
    {
      "group": "Account Analytics",
      "scope": "account",
      "access": "read",
      "reason": "Reads the account's daily usage through the GraphQL Analytics API."
    }
  ]
}
