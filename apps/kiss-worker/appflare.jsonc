{
  // The sync server of KISS Translator, the browser extension: settings, rules
  // and vocabulary sync through it, and shared rules are served from it. One
  // SQLite Durable Object per synced key orders concurrent writes; KV only
  // holds records from upstream's older KV-only server, which the objects copy
  // over on first read, so on a fresh install it stays empty.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "kiss-worker",
  "name": "KISS Worker",
  "summary": "Your own sync server for KISS Translator: keeps the extension's settings, rules and vocabulary in step across browsers and serves shared rule sets.",
  "tagline": "Sync your translation settings and vocabulary across browsers",
  "features": [
    "Keep KISS Translator preferences in sync between browsers",
    "Reuse your translation rules across browsers",
    "Keep your vocabulary lists in sync between browsers",
    "Share translation rule sets through a link"
  ],
  "repo": "fishjar/kiss-worker",
  "license": "MIT",
  "categories": ["sync", "utilities"],
  // The formatting of URLs in the notes changed after this release was published:
  // a revision, no new build.
  // Features (revision 3).
  "revision": 3,
  "authors": [{ "name": "Gabe", "url": "https://fishjar.com", "github": "fishjar" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no tags; the pin follows the default branch.
  "source": { "ref": "master", "sha": "7f6efdec4d97e1d6ed816db5f7d58cd8a65de9c0" },
  "install": {
    "packageManager": "npm",
    // One plain JavaScript file and no build step. The config declares the
    // Durable Object class with an `exports` block (SQLite storage) instead of
    // `migrations`; the artifact carries the block and the manager sends it
    // with the upload, as wrangler does.
    "wranglerConfig": "wrangler.toml",
    // Runs Worker code and needs the sync password: without it every route
    // answers 503, with it this route answers 403 to a request without a key.
    "health": { "path": "/rules" }
  },
  // KV and a SQLite-backed Durable Object both have free tiers.
  "plan": "free",
  "secrets": [
    {
      "name": "AUTH_VALUE",
      "label": "Sync password",
      "help": "The extension's Sync Key: enter the same value there. Copy it before you install; it cannot be read back later, only replaced.",
      "generate": "password"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "In KISS Translator's Sync Setting, set Sync Type to KISS-Worker, Sync API to `{{appUrl}}`, and Sync Key to the sync password from this install."
    },
    {
      "type": "markdown",
      "content": "Rule sets you share from the extension are served from this install at `{{appUrl}}/rules`; the extension shows the full share link."
    }
  ]
}
