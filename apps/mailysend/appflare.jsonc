{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "mailysend",
  "name": "MailySend",
  "summary": "A Resend-compatible email platform in your own account: transactional sending, broadcasts, automations, inbound mail and deliverability analytics, over Cloudflare Email Service, Amazon SES, Resend or SMTP.",
  "tagline": "Send emails and campaigns from your own Cloudflare account",
  "homepage": "https://mailysend.com",
  "repo": "GagnDeep/mailysend",
  "license": "MIT",
  "categories": ["email", "marketing"],
  "authors": [{ "name": "Gagandeep Singh", "github": "GagnDeep" }],
  "maintainers": ["MendyLanda"],
  // MailySend has no release tags yet; the pin tracks main.
  "source": { "ref": "main", "sha": "3708d2f6fdfbb95aa979284733ae83950dc6e115" },
  "install": {
    "packageManager": "pnpm",
    // The app Worker. The separate tracking Worker (apps/track) is optional
    // upstream: the app serves the tracking and unsubscribe routes itself.
    "wranglerConfig": "apps/app/wrangler.jsonc",
    // Upstream's Workers Builds command: the workspace packages, the TanStack
    // Start build through the Cloudflare Vite plugin, then a script that
    // leaves the Analytics Engine datasets out of the generated config (they
    // are opt-in upstream, since an account without Analytics Engine turned on
    // refuses the deploy). Its last step creates resources only inside Workers
    // Builds and does nothing here. The script also copies the generated
    // config to wrangler.json at the root, for Workers Builds' default deploy
    // command; that copy is removed, because wrangler prefers a wrangler.json
    // in any parent directory to the app's own wrangler.jsonc and would refuse
    // to pick between them.
    "buildCommand": ["pnpm run build:cf", "rm wrangler.json"],
    // Answers without a sign-in.
    "health": { "path": "/v1/health" }
  },
  // D1, KV, R2, Queues and SQLite-backed Durable Objects all have free tiers.
  // One cron trigger, every minute (upstream keeps it to one because the
  // free plan allows five per account). Sending through Cloudflare Email
  // Service needs a sending domain onboarded to it; SES, Resend and SMTP work
  // without one.
  "plan": "free",
  "requires": ["r2"],
  // MS_SECRET is generated on first boot and kept in D1, and the public URL is
  // learned from the first request, so nothing is required.
  "secrets": [],
  "vars": [
    {
      "name": "MS_OWNER_EMAIL",
      "label": "Owner email",
      "help": "Optional. Only this address may claim the instance at /setup. Without it, the first person to open /setup becomes the owner.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/setup right away to claim the instance: register a passkey and keep the ten recovery codes it shows. Passkeys are bound to the hostname you claim it on, so claim it on the address you will keep using."
    },
    {
      "type": "markdown",
      "content": "Add a sending domain and a transport under **Settings > Transports**, then create an API key. Point any Resend client at `{{appUrl}}` to send through it."
    }
  ]
}
