{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "workers-firecrawl",
  "name": "Workers Firecrawl",
  "summary": "A Firecrawl-compatible search, scrape and map API on Browser Rendering: point the Firecrawl SDKs at your own Worker and get pages as Markdown, HTML, links or screenshots.",
  "homepage": "https://github.com/G4brym/workers-firecrawl",
  "repo": "G4brym/workers-firecrawl",
  "license": "MIT",
  "categories": ["developer-tools", "ai"],
  "authors": [
    { "name": "Gabriel Massadas", "url": "https://massadas.com", "github": "G4brym", "x": "G4brym" }
  ],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags (its release workflow has not published
  // one); the pin is the head of main.
  "source": { "ref": "main", "sha": "f53a0dc01502401bf790ccb382d41014b8713afb" },
  "install": {
    "tier": "artifact",
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml",
    "workerName": "firecrawl"
  },
  // Upstream's README asks for Workers Paid because Browser Rendering once
  // needed it. It now has a free allowance (10 minutes of browser time a day,
  // 3 concurrent browsers), enough to try the API; heavier use needs Paid.
  "plan": "free",
  "requires": ["browser-rendering"],
  "secrets": [
    // Upstream leaves the API open when the key is unset. It is generated here
    // rather than optional, since every open request spends the account's
    // browser time.
    {
      "name": "AUTHORIZATION_KEY",
      "label": "API key",
      "help": "Callers send it as `Authorization: Bearer <key>`; it is the API key you give the Firecrawl SDK. Every route checks it, the API docs page at / included. Copy it now.",
      "generate": true
    }
  ],
  "vars": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Point a Firecrawl SDK at {{workerUrl}} with the API key, for example `new FirecrawlApp({ apiKey: \"<API key>\", apiUrl: \"{{workerUrl}}\" })`. The endpoints are `POST /v1/search` (web search through DuckDuckGo, with each result scraped), `POST /v1/scrape` and `POST /v1/map`."
    },
    {
      "type": "markdown",
      "content": "The OpenAPI docs at {{workerUrl}} need the same `Authorization` header, so a plain browser visit answers 401. Browser Rendering on the free plan allows 10 minutes of browser time a day."
    }
  ],
  "tokenPermissions": []
}
