{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "2fa",
  "name": "2FA",
  "summary": "A two-factor code manager for TOTP and HOTP keys: scan or import from Google Authenticator, Aegis, 2FAS, and Bitwarden, encrypted in KV, with backups to WebDAV, S3, OneDrive, or Google Drive.",
  "tagline": "Store your two-factor codes with automatic backups",
  "repo": "wuzf/2fa",
  "license": "MIT",
  "categories": ["security", "utilities"],
  "authors": [{ "name": "wuzf", "github": "wuzf" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v1.9.0", "sha": "9e58e54fa3ad1e5812ec1333bc00de205aac476e" },
  "install": {
    "packageManager": "npm",
    // Plain JavaScript with no build step. Upstream's deploy script only
    // stamps a service worker version and a KV id; the service worker loads
    // pages network first, so updates show without it.
    "wranglerConfig": "wrangler.toml"
  },
  // KV (1,000 writes a day) and one daily backup cron fit the free plan.
  "plan": "free",
  // The Google Drive and OneDrive backup targets need upstream's OAuth client
  // secrets (GOOGLE_DRIVE_CLIENT_ID, ONEDRIVE_CLIENT_ID, and their secrets);
  // add them later as secrets in the Worker's settings, where updates keep them.
  "secrets": [
    {
      "name": "ENCRYPTION_KEY",
      "label": "Encryption key",
      "help": "Encrypts your keys, backups, and backup credentials with AES-GCM. Copy it now into a password manager: Cloudflare never shows it again, and without it the stored keys and every encrypted backup cannot be read.",
      // Upstream suggests 32 random bytes in base64. The generated value is 32
      // base64 characters, which decode to a 24-byte (AES-192) key; Workers
      // accept AES keys of 128, 192, or 256 bits.
      "generate": "password"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Save the encryption key from the install form in a password manager or offline now. Losing it makes every stored key and encrypted backup unreadable, and Appflare keeps no copy."
    },
    {
      "type": "markdown",
      "content": "Open {{appUrl}} right away and set the admin password: the first visitor sets it. Then add keys with the + button, by scanning a QR code or importing an export."
    }
  ],
  // Upstream releases under semver tags with release notes; the install check
  // runs each one before it merges.
  "bump": { "autoMerge": true }
}
