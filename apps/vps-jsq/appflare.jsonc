{
  // A static calculator page: the Worker only serves the built files, and
  // nothing is stored on the server. The page fetches exchange rates from the
  // public open.er-api.com service in the visitor's browser and keeps its
  // settings in the browser's local storage.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "vps-jsq",
  "name": "VPS-JSQ",
  "summary": "Calculate the unused value of a prepaid VPS from its renewal price, billing cycle and dates, then set a resale premium. Includes currency conversion, live exchange rates and shareable image cards. Chinese interface.",
  "tagline": "See what the unused time on a prepaid server is worth",
  "homepage": "https://jsq.xiaoge.org",
  "repo": "verkyer/vps-jsq",
  "license": "Apache-2.0",
  "categories": ["finance", "utilities"],
  "revision": 2,
  "authors": [{ "name": "XiaoGe", "url": "https://www.xiaoge.org/", "github": "verkyer" }],
  "maintainers": ["MendyLanda"],
  // Upstream publishes no release tags; the pin tracks main.
  "source": { "ref": "main", "sha": "c9739a42571498aa8f384ccbe9a215571eae3974" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml",
    // The Vite build writes the page to dist/, which the config serves as
    // static assets; the config has no build.command.
    "buildCommand": "npm run build"
  },
  // Static assets and a Worker that only hands requests to them.
  "plan": "free",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} to use the calculator. Exchange rates come from open.er-api.com, fetched by each visitor's browser."
    }
  ]
}
