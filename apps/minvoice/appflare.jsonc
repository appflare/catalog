{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "minvoice",
  "name": "Minvoice",
  "summary": "Invoicing for one business: invoices with PDF attachments, pay links through Stripe and PayPal, payment reminders, reports and CSV export, on D1.",
  "tagline": "Create invoices with pay links and payment reminders",
  "homepage": "https://minvoice.dev",
  "repo": "ddyy/minvoice",
  "license": "MIT",
  "categories": ["business", "finance"],
  // Upstream has not moved since the released pin, so the public paths below
  // are a revision of that build.
  "revision": 2,
  "authors": [{ "name": "Daniel Yang", "url": "https://daniel-yang.com", "github": "ddyy" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin tracks the default branch, main.
  "source": { "ref": "main", "sha": "99563a5a4d8e90481e76d2440c719c909a67f243" },
  "install": {
    "packageManager": "npm",
    // The zero-config starter the Deploy button uses: the Worker, its D1
    // database, static assets and a daily cron. Upstream's production
    // template (wrangler.jsonc.example) cannot be used, since the packer
    // refuses a template next to a different wrangler.jsonc; without its
    // send_email binding, Resend is the app's email provider.
    "wranglerConfig": "wrangler.jsonc",
    // Answers without a sign-in and checks the database.
    "health": { "path": "/health" }
  },
  // D1 and one daily cron fit the free plan, and so does sending with Resend.
  "plan": "free",
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD take Appflare's Access values (below).
  // Protection is offered, not required, so "access" asks for a Zero Trust
  // organization only for a protected install.
  "requires": ["access"],
  // Protection is offered, switched off: the admin signs in with a password
  // until the app is protected, and with the Access sign-in after (the two
  // vars below are then filled in). When the app is protected, what clients and
  // payment providers reach stays public (src/index.tsx: "Public +
  // provider-facing routes — deliberately outside the Access boundary"): the
  // pay pages and their PDFs, the Stripe and PayPal webhooks, the static
  // files the pay pages load (public/), and /health, which upstream keeps
  // public for uptime monitors. /logo is left out: only the admin settings
  // page loads it.
  "access": {
    "bypass": ["/pay/*", "/webhooks/*", "/styles.css", "/fonts/*", "/favicon.svg", "/health"]
  },
  // Seeded from upstream's .dev.vars.example. Every payment and email key can
  // also be entered later in the app's Settings page, which stores it in D1
  // encrypted with SETTINGS_MASTER_KEY; a secret set here wins over that.
  "secrets": [
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "help": "Signs you in at /admin. Pick something long. Setting the Cloudflare Access team domain and audience tag (below) turns the password sign-in off."
    },
    {
      "name": "SETTINGS_MASTER_KEY",
      "label": "Settings encryption key",
      "help": "Encrypts the API keys you enter in Settings before they are stored in D1. Changing it makes those stored keys unreadable, so they must be entered again.",
      "generate": "password"
    },
    {
      "name": "STRIPE_SECRET_KEY",
      "label": "Stripe secret key",
      "help": "For card payments through Stripe Checkout (sk_live_... or sk_test_...). Can also be entered in Settings.",
      "optional": true
    },
    {
      "name": "STRIPE_WEBHOOK_SECRET",
      "label": "Stripe webhook signing secret",
      "help": "The whsec_... secret of a Stripe webhook endpoint pointing at /webhooks/stripe on this app.",
      "optional": true
    },
    {
      "name": "PAYPAL_CLIENT_ID",
      "label": "PayPal client ID",
      "help": "For PayPal payments, from a PayPal Business app. Can also be entered in Settings.",
      "optional": true
    },
    {
      "name": "PAYPAL_CLIENT_SECRET",
      "label": "PayPal client secret",
      "help": "The secret of the PayPal app above.",
      "optional": true
    },
    {
      "name": "PAYPAL_WEBHOOK_ID",
      "label": "PayPal webhook ID",
      "help": "The id of a PayPal webhook pointing at /webhooks/paypal on this app.",
      "optional": true
    },
    {
      "name": "RESEND_API_KEY",
      "label": "Resend API key",
      "help": "To send invoices and reminders through Resend, with your domain verified there. Can also be entered in Settings.",
      "optional": true
    }
  ],
  // None of these is in the starter config; each reaches the Worker only
  // when it is given a value.
  "vars": [
    {
      "name": "APP_BASE_URL",
      "label": "Public URL",
      "help": "The address pay links and emails point to, without a trailing slash, for example https://invoice.example.com. Leave empty to use the address each request arrives at.",
      "optional": true
    },
    {
      // Without https://: src/middleware/access.ts prefixes it for the issuer
      // and the certs URL. src/lib/admin-auth.ts turns the password sign-in
      // off only when it ends in .cloudflareaccess.com and ACCESS_AUD is 64
      // hex characters, so both stay empty, and the password works, while the
      // app is unprotected.
      "name": "ACCESS_TEAM_DOMAIN",
      "label": "Cloudflare Access team domain",
      "help": "Filled in by Appflare from the app's Cloudflare Access protection: your Zero Trust team domain. While it and the audience tag are set, /admin signs you in through Cloudflare Access and the password sign-in is off. Empty while the app is unprotected.",
      "optional": true,
      "default": "{{accessTeamDomain}}"
    },
    {
      "name": "ACCESS_AUD",
      "label": "Cloudflare Access audience tag",
      "help": "Filled in by Appflare: the audience tag of the app's Cloudflare Access application. Empty while the app is unprotected.",
      "optional": true,
      "default": "{{accessAud}}"
    },
    {
      "name": "PAYPAL_API_BASE",
      "label": "PayPal API address",
      "help": "Leave empty to choose live or sandbox in Settings. Setting it (https://api-m.paypal.com or https://api-m.sandbox.paypal.com) fixes the choice.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/admin and sign in with the admin password, or through Cloudflare Access if you installed the app protected. The first visit runs a setup wizard for your business details."
    },
    {
      "type": "markdown",
      "content": "Connect payments and email under Settings. For Stripe, add a webhook endpoint at `{{appUrl}}/webhooks/stripe`; for PayPal, one at `{{appUrl}}/webhooks/paypal`. Payment reminders are off until you turn them on under Settings, Email; a daily cron at 15:00 UTC sends them."
    }
  ]
}
