{
  // Sink records every visit in the Analytics Engine dataset `sink` and reads
  // it back under NUXT_DATASET, whose default is the same name. The dataset
  // keeps its upstream name, and dataset names are account-wide, so a second
  // install in the same account would share the first one's visit data.
  // Install it once per account.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "sink",
  "name": "Sink",
  "summary": "Link shortener with visit analytics: custom slugs, expiring links, QR codes, AI slug suggestions and a realtime globe, all on Cloudflare.",
  "tagline": "Create short links and track their visits",
  "homepage": "https://sink.cool",
  "repo": "miantiao-me/Sink",
  "license": "AGPL-3.0-only",
  "categories": ["utilities", "analytics"],
  "authors": [
    {
      "name": "miantiao",
      "url": "https://miantiao.me",
      "github": "miantiao-me",
      "x": "miantiao_me"
    }
  ],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.3.1", "sha": "bafa4e1f7e3ec034929e11e5542c4c3e116d69da" },
  "install": {
    "packageManager": "pnpm",
    "wranglerConfig": "wrangler.jsonc",
    // Upstream deploys with `pnpm build` after a `pnpm install` that runs its
    // postinstall. Here neither install scripts nor pre/post hooks run, so
    // each step is listed: `build:map` (postinstall) writes the dashboard's
    // world map to public/, `build:sphere` (prebuild) the globe's mesh, then
    // the Nuxt build, which gives Node an 8 GiB heap in its own script.
    "buildCommand": ["pnpm run build:map", "pnpm run build:sphere", "pnpm run build"]
  },
  // D1, KV, R2, Analytics Engine and Workers AI all have free allowances.
  "plan": "free",
  // Backups and social images go to R2; AI slug and preview suggestions use Workers AI.
  "requires": ["r2", "workers-ai"],
  "secrets": [
    {
      "name": "NUXT_SITE_TOKEN",
      "label": "Site token",
      "help": "The dashboard's sign-in password and the API key for Sink's API. At least 8 characters; keep it stable, since changing it signs out every browser and API client."
    },
    {
      "name": "NUXT_CF_API_TOKEN",
      "label": "Analytics API token",
      "help": "A Cloudflare API token with Account Analytics Read on this account, used to read visits through the Analytics Engine SQL API. Without it links still work, but the charts, logs and realtime view stay empty.",
      "optional": true,
      "cloudflareToken": true
    }
  ],
  "vars": [
    {
      "name": "NUXT_CF_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "help": "The account whose Analytics Engine data the dashboard reads: this one. Filled in on every install and update.",
      "default": "{{accountId}}"
    },
    {
      "name": "NUXT_HOME_URL",
      "label": "Home page redirect",
      "help": "Send visitors of / to this URL instead of Sink's home page.",
      "optional": true
    },
    {
      "name": "NUXT_NOT_FOUND_REDIRECT",
      "label": "Unknown link redirect",
      "help": "Send visitors of a short link that does not exist to this URL (always a 302) instead of a 404 page.",
      "optional": true
    },
    {
      "name": "NUXT_REDIRECT_STATUS_CODE",
      "label": "Redirect status",
      "help": "The HTTP status short links answer with.",
      "type": "select",
      "default": "301",
      "options": [
        { "value": "301", "label": "301 Moved Permanently" },
        { "value": "302", "label": "302 Found" },
        { "value": "307", "label": "307 Temporary Redirect" },
        { "value": "308", "label": "308 Permanent Redirect" }
      ],
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/dashboard, sign in with the site token, and open **Links** once: it finishes Sink's storage setup, and creating links fails with \"storage not ready\" until then."
    },
    {
      "type": "markdown",
      "content": "Visit analytics need the analytics API token. Sink keeps visits in the Analytics Engine dataset `sink`, whose name is shared by the whole account, so install Sink only once per account. A daily job backs up the links to the R2 bucket."
    }
  ],
  "tokenPermissions": [
    {
      "group": "Account Analytics",
      "scope": "account",
      "access": "read",
      "reason": "Optional: reads visits through the Analytics Engine SQL API for the charts, logs and realtime view."
    }
  ],
  // Nuxt and its many dependencies move often; each bump gets a human review.
  "bump": { "autoMerge": false }
}
