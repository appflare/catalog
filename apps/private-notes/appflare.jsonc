{
  // The browser encrypts each note's title and body (PBKDF2-SHA256 and
  // AES-256-GCM) with the vault password before it is sent; D1 keeps only
  // ciphertext, timestamps and sign-in rate limits. The Worker also holds the
  // password, as a secret, to check sign-ins, so whoever administers the
  // account is inside the trust boundary.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "private-notes",
  "name": "Private Notes",
  "summary": "A private notebook behind one password: notes encrypted in the browser before they reach D1, search that runs in the browser, separate vaults per password, and one-time share links that burn after reading.",
  "tagline": "Keep encrypted notes behind a password",
  "features": [
    "Encrypt note titles and text in your browser before saving",
    "Keep separate notebooks that open with different passwords",
    "Search and filter your notes in your browser",
    "Share a copy of a note through a link that can be opened once",
    "Share notes through links that expire after 24 hours or 7 days"
  ],
  "alternativeTo": ["ProtectedText"],
  "repo": "tao-t356/private-notes",
  "license": "NONE",
  "categories": ["notes", "privacy"],
  // Generated secrets added after this release was published: a revision, no new build.
  // Features and alternatives (revision 3).
  "revision": 3,
  "authors": [{ "name": "tao-t356", "github": "tao-t356" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags, so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "e1f92dae4064a485b30b548f1109dcca5d9e653d" },
  "install": {
    "packageManager": "npm",
    // No build step: the Worker is TypeScript wrangler bundles, and public/
    // holds the page's hand-written JavaScript and CSS.
    "wranglerConfig": "wrangler.jsonc",
    // Answers without a session.
    "health": { "path": "/api/session" }
  },
  // One Worker, static assets and D1 fit the free plan. No cron triggers.
  "plan": "free",
  "secrets": [
    {
      // Any value up to 1024 characters except upstream's example
      // (src/auth.ts:10,20,189-191).
      "name": "APP_PASSWORD",
      "label": "Password",
      "help": "Signs you in and, in the browser, derives the key that encrypts your notes. Keep it in a password manager: notes cannot be decrypted without it, and it cannot be recovered from the app.",
      "generate": "password"
    },
    {
      "name": "APP_PASSWORDS",
      "label": "More vaults",
      "help": "Extra passwords, each opening a separate vault, as vault_id=password pairs separated by commas, for example work=one-long-password,family=another. Vault ids are lower-cased letters, digits, - and _.",
      "optional": true
    },
    {
      "name": "COOKIE_SECRET",
      "label": "Session signing key",
      "help": "At least 32 characters. Leave empty and the Worker creates a random key of its own in D1. Setting or changing it signs everyone out and voids share links not yet opened.",
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "APP_NAME",
      "label": "App name",
      "help": "Shown in the page title and when the app is added to a phone's home screen. Leave empty for Private Notes.",
      "optional": true
    },
    {
      "name": "APP_SHORT_NAME",
      "label": "Short name",
      "help": "The name under the home-screen icon. Leave empty for upstream's Chinese default, 我的笔记.",
      "optional": true
    },
    {
      "name": "APP_DESCRIPTION",
      "label": "Description",
      "help": "The description in the web app manifest. Leave empty for upstream's, in Chinese.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and sign in with the password from this install. Each password opens its own vault; a share link lets one person read a copy of one note once, within the time you choose."
    }
  ]
}
