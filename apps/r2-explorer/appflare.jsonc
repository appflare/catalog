{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "r2-explorer",
  "name": "R2 Explorer",
  "summary": "Browse folders, preview files and download objects from an R2 bucket through a read-only web interface.",
  "tagline": "Browse and preview files in your Cloudflare storage",
  "features": [
    "Browse the folders and files in your storage bucket",
    "Preview images and PDF documents in your browser",
    "Read text, Markdown and CSV files without downloading them",
    "Download stored files to your device"
  ],
  "homepage": "https://r2explorer.com",
  "repo": "cloudflare/templates",
  // The template pins r2-explorer 1.1.10. Its upstream README links back to this
  // Deploy-button template: https://github.com/G4brym/R2-Explorer/tree/v1.1.10.
  "upstreamRepo": "G4brym/R2-Explorer",
  "license": "MIT",
  "categories": ["files"],
  // The category changed after this release was published, and the Access
  // protection below came later still: revisions, no new build (the template is
  // unchanged in the repository's newer tags).
  // Features (revision 5).
  "revision": 5,
  "authors": [
    {
      "name": "Gabriel Massadas",
      "url": "https://massadas.com",
      "github": "G4brym",
      "x": "G4brym"
    },
    { "name": "Cloudflare", "url": "https://www.cloudflare.com", "github": "cloudflare" }
  ],
  "maintainers": ["MendyLanda"],
  // The Deploy-button template lives in a subdirectory of cloudflare/templates;
  // wranglerConfig points into it. The repository's semver tags cover every
  // template, so a bump can move the pin while this template is unchanged.
  "source": {
    "ref": "v11.0.0",
    "sha": "47645c985c10aa8afc2f837b983a3678a36a60cb",
    // The cloudflare/templates tag numbers the whole monorepo; this is the
    // R2 Explorer release the template ships. Change it whenever source moves.
    "version": "1.1.10"
  },
  "install": {
    "packageManager": "pnpm",
    "wranglerConfig": "r2-explorer-template/wrangler.json",
    // Runs Worker code (the static dashboard at / would answer even if the Worker
    // failed) and needs no credentials.
    "health": { "path": "/api/server/config" }
  },
  // R2's free tier covers this app, but R2 has to be enabled on the account
  // first, which needs a payment method on file.
  "plan": "free",
  // "access": the app installs only behind Cloudflare Access (below).
  "requires": ["r2", "access"],
  // The template sets no authentication and cannot be given any through
  // secrets or vars: unprotected, anyone with the URL lists and downloads
  // every file in the bucket. So protection is required; nothing must stay
  // public.
  "access": { "mode": "required" },
  // The template configures authentication in code, not through secrets or vars.
  "secrets": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} to browse the new R2 bucket. It is read-only: upload files with the Cloudflare dashboard or `wrangler r2 object put`."
    },
    {
      "type": "markdown",
      "content": "**R2 Explorer has no sign-in of its own**, so Appflare keeps it behind Cloudflare Access: only the people who use this Appflare can list and download the files in the bucket."
    },
    {
      "type": "markdown",
      "content": "R2 must be enabled on the account before installing, which needs a payment method on file even though R2's free tier covers typical use."
    }
  ]
}
