{
  // The Worker is the redirect engine and the admin API. Upstream's dashboard
  // is a single index.html kept outside the Worker: opened from disk or any
  // static host, it talks to the API with the admin key.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "relay",
  "name": "Relay",
  "summary": "A link shortener with cookieless click and conversion analytics: A/B splits, device and country routing, per-channel suffixes, retargeting pixels, QR codes and CSV export, on D1.",
  "tagline": "Short links you control, with cookieless click and conversion stats",
  "homepage": "https://github.com/YuriCrystal/relay",
  "repo": "YuriCrystal/relay",
  "license": "MIT",
  "categories": ["utilities", "analytics"],
  "authors": [{ "name": "Yuri", "github": "YuriCrystal" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags, so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "7fb2f441e19e7ba446bfbd0cd0e3ca0f53edfb45" },
  "install": {
    "tier": "artifact",
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml",
    "workerName": "relay",
    // Upstream ships no lockfile: the package has no dependencies, and the
    // Worker is one plain module wrangler bundles as it is.
    "installDirs": [{ "path": ".", "lockfile": "none" }]
  },
  // One Worker and D1 fit the free plan.
  "plan": "free",
  "requires": [],
  "secrets": [
    {
      "name": "ADMIN_TOKEN",
      "label": "Admin key",
      "help": "Every /api request needs it as a Bearer token; the dashboard asks for it once and keeps it in the browser.",
      "generate": true
    },
    {
      "name": "SALT",
      "label": "Visitor hash salt",
      "help": "Salts the daily hash that counts unique visitors (IPs are never stored). Without it Relay salts with the admin key, so changing the key would restart the counts.",
      "generate": true
    },
    {
      "name": "CONVERSION_TOKEN",
      "label": "Conversion token",
      "help": "When set, conversion reports to /track must carry it; without it anyone can report a conversion.",
      "optional": true
    },
    {
      "name": "SAFEBROWSING_KEY",
      "label": "Google Safe Browsing API key",
      "help": "Checks each new destination against Google Safe Browsing and refuses malicious ones.",
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "DASH_ORIGIN",
      "label": "Dashboard origin",
      "help": "The origin the dashboard runs on, for CORS, for example https://relay-admin.example.com. * allows any origin; the API still needs the admin key."
    },
    {
      "name": "TZ_OFFSET",
      "label": "Time zone offset",
      "help": "Hours from UTC for the dashboard's daily and hourly charts, for example 0, -5 or 8."
    },
    {
      "name": "BLOCKLIST",
      "label": "Blocked destination domains",
      "help": "Comma separated, subdomains included, for example bit.ly,grabify.link. Leave empty to block none."
    },
    {
      "name": "RESPECT_DNT",
      "label": "Honour Do Not Track",
      "help": "Set to 1 to record no click from visitors who send Do Not Track or Global Privacy Control."
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Download the dashboard, [index.html](https://raw.githubusercontent.com/YuriCrystal/relay/7fb2f441e19e7ba446bfbd0cd0e3ca0f53edfb45/index.html), and open it in a browser (or put it on any static host). Under Settings, enter `{{workerUrl}}` as the Worker API URL and the admin key from this install, then choose Test connection."
    },
    {
      "type": "markdown",
      "content": "Short links answer at `{{workerUrl}}/<slug>`, and `{{workerUrl}}/<slug>/<suffix>` counts each suffix as its own source."
    }
  ],
  "tokenPermissions": [],
  "resources": {
    "d1": {
      // Upstream applies this file by hand after deploying; every statement
      // creates only what is missing.
      "DB": { "schema": ["schema.sql"] }
    }
  }
}
