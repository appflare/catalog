{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "cut",
  "name": "Cut",
  "summary": "Self-hosted link shortener on Workers + KV.",
  "tagline": "Short links on your own domain",
  "repo": "MendyLanda/cut",
  "license": "MIT",
  "categories": ["utilities"],
  "authors": [{ "name": "Mendy Landa", "github": "MendyLanda" }],
  "maintainers": ["MendyLanda"],
  // Cut has no release tags yet; the pin tracks main. The bump bot edits this.
  "source": { "ref": "v0.1.0", "sha": "6056400d47530aa87e4ae5764b37ffca9d00e87f" },
  "install": {
    "packageManager": "pnpm",
    "wranglerConfig": "wrangler.jsonc"
  },
  "plan": "free",
  "secrets": [
    {
      "name": "ADMIN_PASSWORD",
      "label": "Admin password",
      "help": "Used to sign in to /admin.",
      "generate": "password"
    }
  ],
  "vars": [
    {
      "name": "HOME_PAGE",
      "label": "Home page",
      "help": "What / shows. Short links and /admin work the same either way.",
      "optional": true,
      "type": "select",
      "options": [
        { "value": "default", "label": "Show the landing page" },
        { "value": "404", "label": "Return an empty 404 response" },
        { "value": "admin", "label": "Redirect to /admin" }
      ],
      "default": "default"
    }
  ],
  "openPath": "/admin",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/admin and sign in with the admin password to create your first link."
    }
  ],
  // The HOME_PAGE select came in revision 3, which this release was built with.
  // openPath added after it was published: a revision, no new build.
  "revision": 4
}
