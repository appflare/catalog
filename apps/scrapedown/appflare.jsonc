{
  // Reader mode as an API: GET /?url=<page> fetches the page, keeps the
  // article with Mozilla Readability and returns it as Markdown with its
  // title, byline and excerpt. No storage, no bindings.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "scrapedown",
  "name": "scrapedown",
  "summary": "Turn any web page into clean Markdown: one GET with a URL returns the article's text in reader mode, with its title, byline, excerpt and language.",
  "tagline": "Turn web pages into clean, readable text",
  "features": [
    "Fetch an article as Markdown by supplying its web address",
    "Keep the article text and remove the surrounding page content",
    "Get the title, author and excerpt alongside the article",
    "Choose cleaned HTML and plain text instead of Markdown"
  ],
  "alternativeTo": ["Jina Reader"],
  "repo": "ozanvos/scrapedown",
  "license": "MIT",
  "categories": ["developer-tools", "utilities"],
  // The note on Cloudflare Access changed after this release was published: a
  // revision, no new build.
  // Added features and alternatives (revision 4).
  "revision": 4,
  "authors": [
    {
      "name": "Ozan van Oosten-Şener",
      "url": "https://getairefs.com",
      "github": "ozanvos",
      "x": "ozanvos"
    }
  ],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin is the head of main, unchanged
  // since January 2024.
  "source": { "ref": "main", "sha": "807d685b3efe4438deace2429bf01c9c0f76ca43" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.toml"
  },
  // One stateless Worker: one outbound fetch per request.
  "plan": "free",
  // Upstream has no access key: anyone who knows the address can use it.
  // No `access` block: the endpoint is called by programs, which cannot sign
  // in to Cloudflare Access, so protection stays offered and off.
  "secrets": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Request {{appUrl}}/?url=https://example.com for the page as Markdown in `page.textContent`, or add `&markdown=false` for cleaned HTML and plain text instead."
    },
    {
      "type": "markdown",
      "content": "The endpoint has no key: anyone who learns this address can have your Worker fetch pages, within your Workers request allowance. Keep the address to yourself. Cloudflare Access protection would admit only Appflare's users signed in through a browser, so scripts and other programs could no longer call it."
    }
  ]
}
