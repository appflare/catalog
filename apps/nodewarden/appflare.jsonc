{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "nodewarden",
  "name": "NodeWarden",
  "summary": "A Bitwarden-compatible password manager server: the official Bitwarden apps and browser extensions sync to it, with a web vault, attachments, Send, and passkey sign-in, on D1 and R2.",
  "tagline": "A password vault that syncs with your Bitwarden apps",
  "homepage": "https://nodewarden.app",
  "repo": "shuaiplus/nodewarden",
  "license": "LGPL-3.0-only",
  "categories": ["security", "passwords"],
  // The formatting of URLs in the notes changed after this release was published:
  // a revision, no new build.
  "revision": 2,
  "authors": [{ "name": "Shuai", "url": "https://shuai.plus", "github": "shuaiplus" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v1.8.1", "sha": "e92c91e771fac13c54042902d64d015514daa9ad" },
  "install": {
    "packageManager": "npm",
    // The R2 variant, upstream's default. wrangler.kv.toml keeps attachments in
    // KV instead, which the free plan limits to 1,000 writes a day. The web
    // vault is built by the config's own build.command (npm run build).
    "wranglerConfig": "wrangler.toml",
    // Runs Worker code without credentials: the server configuration Bitwarden
    // clients read when they connect.
    "health": { "path": "/api/config" }
  },
  // D1, SQLite-backed Durable Objects, and R2 (10 GB) all have free tiers.
  "plan": "free",
  // Attachments and Send files are stored in R2, which has to be enabled on the
  // account first.
  "requires": ["r2"],
  "secrets": [
    {
      "name": "JWT_SECRET",
      "label": "Token signing secret",
      "help": "Signs sign-in tokens, attachment links, and passkey challenges. At least 32 characters; changing it later signs every device out.",
      "generate": "password"
    }
  ],
  // The passkey relying party (WEBAUTHN_RP_ID, WEBAUTHN_RP_NAME,
  // WEBAUTHN_ALLOWED_ORIGINS) defaults to the address the vault is opened at,
  // which is what a single-domain install wants.
  "vars": [
    {
      "name": "HIDE_WEB_VAULT",
      "label": "Web vault",
      "help": "Hiding it makes the server's web pages answer 404. Bitwarden apps, extensions, and an already installed web vault app keep working.",
      "optional": true,
      "type": "select",
      "options": [
        { "value": "0", "label": "Serve the web vault" },
        { "value": "1", "label": "Hide the web vault" }
      ],
      "default": "0"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and create your account right away: the first account registered becomes the admin, and every later account needs an invite code from the admin page."
    },
    {
      "type": "markdown",
      "content": "In a Bitwarden app or browser extension, choose a self-hosted server and enter `{{appUrl}}` as the server URL. Back up your vault regularly from the web vault's backup center; NodeWarden is not affiliated with Bitwarden."
    }
  ],
  // Upstream publishes each release under a semver tag with release notes; the
  // install check runs every one before it merges.
  "bump": { "autoMerge": true }
}
