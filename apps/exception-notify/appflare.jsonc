{
  // The web workspace of Exception-Notify, a Spring Boot starter that posts
  // unhandled exceptions to DingTalk, Feishu or WeChat Work. The library sends
  // each exception's details to this app's /api/compress and puts the
  // returned link in the alert; the page then shows the exception and lets
  // you discuss it with an AI provider of your choice, called from the
  // browser with a key kept in the browser. Payloads are kept for 30 days in
  // KV, with a copy in D1 as the fallback store.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "exception-notify",
  "name": "Exception-Notify workspace",
  "summary": "The AI analysis page for Exception-Notify alerts from Spring Boot: open an exception from DingTalk, Feishu or WeChat Work and work through it with your own AI provider.",
  "tagline": "Read error alerts and work through fixes with AI",
  "homepage": "https://fixit.nolimit35.com",
  "repo": "GuangYiDing/exception-notify",
  // The repository has no LICENSE file; its README and pom.xml both declare
  // Apache License 2.0.
  "license": "Apache-2.0",
  "categories": ["developer-tools", "monitoring"],
  "revision": 2,
  "authors": [{ "name": "XiaoDingSiRen", "url": "https://nolimit35.cn", "github": "GuangYiDing" }],
  "maintainers": ["MendyLanda"],
  // The repository's tags (v1.3.3-RELEASE and earlier) version the Java
  // library and read as prereleases; the pin tracks main, and moves only when
  // web/ changes.
  "source": { "ref": "main", "sha": "990d2e6ad2ddb2eae62c1c46f4b4fcd44ca6ebdd" },
  "install": {
    // web/ holds both lockfiles; upstream's own deploy workflow installs
    // from package-lock.json.
    "packageManager": "npm",
    // The repository root is the Maven project; the Worker is the Next.js
    // app in web/.
    "installDirs": [{ "path": "web" }],
    // The config's ${...} placeholders are filled in by upstream's deploy
    // workflow; the ids are the install's own here.
    "wranglerConfig": "web/wrangler.toml",
    // OpenNext builds the Next.js app into web/.open-next/.
    "buildCommand": "npm --prefix web run build:opennextjs"
  },
  // Workers, KV and D1 fit the free plan.
  "plan": "free",
  "postInstall": [
    {
      "type": "markdown",
      "content": "Point the library at this app in your Spring Boot configuration:\n\n```yaml\nexception:\n  notify:\n    ai:\n      enabled: true\n      analysis-page-url: {{appUrl}}\n```\n\nAlerts then carry an **Open AI Analysis** link to {{appUrl}}. Set your AI provider's endpoint and key in the page's settings; they stay in your browser."
    },
    {
      "type": "markdown",
      "content": "`/api/compress` accepts any JSON without a sign-in, as the library needs it to, and each new payload is a KV write (the free plan allows 1,000 a day). Anyone with a link can read that payload for 30 days."
    }
  ]
}
