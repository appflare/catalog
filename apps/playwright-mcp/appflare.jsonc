{
  // Cloudflare's Playwright MCP server: AI assistants get browser tools
  // (navigate, click, type, snapshot, screenshot, save as PDF) that drive a
  // headless Chrome from Browser Rendering in your account. Each MCP session
  // is a SQLite-backed Durable Object that holds its browser.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "playwright-mcp",
  "name": "Cloudflare Playwright MCP",
  "summary": "A remote MCP server that lets AI assistants browse for you: navigate, click, type, read page snapshots and take screenshots in a headless browser from Cloudflare Browser Rendering.",
  "tagline": "Let your AI assistant browse websites and take screenshots",
  "features": [
    "Ask an AI assistant to open websites and follow links",
    "Let your assistant fill in forms and click page controls",
    "Read page content through snapshots your assistant can inspect",
    "Capture screenshots and save pages as PDFs"
  ],
  // This app is Cloudflare's Browser Rendering adaptation of Playwright MCP:
  // https://github.com/cloudflare/playwright-mcp/blob/ee81e278966626f9ad72d94bdb16f949d06744e5/cloudflare/package.json
  "repo": "cloudflare/playwright-mcp",
  "license": "Apache-2.0",
  "categories": ["ai", "developer-tools"],
  "revision": 5,
  "authors": [
    {
      "name": "Cloudflare",
      "url": "https://www.cloudflare.com",
      "github": "cloudflare",
      "x": "Cloudflare"
    },
    { "name": "Microsoft Corporation", "github": "microsoft" }
  ],
  "maintainers": ["MendyLanda"],
  // The head of main, not the v0.0.5 tag: at the tag the deployable example
  // still installs @cloudflare/playwright-mcp 0.0.4 from its lockfile, and the
  // commits after it move the example to 0.0.5, the release the tag names.
  "source": { "ref": "main", "sha": "ee81e278966626f9ad72d94bdb16f949d06744e5" },
  "install": {
    "packageManager": "npm",
    // The deployable server is the example in cloudflare/example, its own npm
    // project with its own lockfile; it takes the MCP library from npm rather
    // than from the library sources at the root. No build step.
    "installDirs": [{ "path": "cloudflare/example" }],
    "wranglerConfig": "cloudflare/example/wrangler.toml"
  },
  // Browser Rendering is on the free plan with 10 minutes of browser time a
  // day and 3 browsers at once; Workers Paid raises both, billed by use.
  "plan": "free",
  "requires": ["browser-rendering"],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Add the server to an MCP client with the URL `{{appUrl}}/mcp` (Streamable HTTP) or `{{appUrl}}/sse` (SSE), for example `claude mcp add --transport http playwright {{appUrl}}/mcp`, or in VS Code `code --add-mcp '{\"name\":\"playwright\",\"type\":\"sse\",\"url\":\"{{appUrl}}/sse\"}'`."
    },
    {
      "type": "markdown",
      "content": "The server has no sign-in: anyone who knows the address can run browsers on your Browser Rendering allowance. Keep the address private."
    }
  ]
}
