{
  // Disposable forwarding addresses on your own domains: each address is an
  // Email Routing rule that forwards to one of your verified destination
  // addresses, and a cron trigger turns it off on its expiry date and can
  // delete it a month later. The app manages the rules itself through the
  // Cloudflare API, with a token of its own. It has no sign-in and expects
  // Cloudflare Access in front of it.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "dispoflare",
  "name": "Dispoflare",
  "summary": "Disposable email addresses on your own domains: create a random or chosen address that forwards to your inbox until the date you pick, on Email Routing.",
  "tagline": "Disposable email addresses on your own domains",
  "features": [
    "Choose a random or custom name for each email address",
    "Forward mail to your verified inbox",
    "Set when each forwarding address expires",
    "Remove expired addresses automatically after a month"
  ],
  "alternativeTo": ["Firefox Relay"],
  "repo": "LeoColomb/dispoflare",
  "license": "MIT",
  "categories": ["email", "privacy"],
  // The tag the entry pins has not moved since the released build, so the Access
  // protection below (revision 2) and the field links (revision 3) are revisions
  // of that build.
  // Features and alternatives (revision 4), no new build.
  "revision": 4,
  "authors": [
    {
      "name": "Léo Colombaro",
      "url": "https://colombaro.fr",
      "github": "LeoColomb",
      "x": "LeoColomb"
    }
  ],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "2.0.1", "sha": "46f4acae087178b4ca5edac3cbe613b324249f9e" },
  "install": {
    "packageManager": "npm",
    // React Router through the Cloudflare Vite plugin, which writes the
    // Worker and the config wrangler deploys from under build/ and points
    // wrangler at it; the packer follows that redirect.
    "wranglerConfig": "wrangler.jsonc",
    // The cron job points an address that reaches its deprecation date at
    // the Worker named "dispoflare" (workers/scheduled.ts), and it acts on
    // every Dispoflare rule the token can see, so the app runs once per
    // account under that name.
    "fixedWorkerName": true,
    // Upstream's build script (react-router build); the config has no
    // build.command.
    "buildCommand": "npm run build"
    // No `emailRouting`: the app creates one routing rule per address itself,
    // with CLOUDFLARE_API_TOKEN, on the zones where Email Routing is on.
  },
  // Email Routing and one cron trigger (of the free plan's five per
  // account); no storage.
  "plan": "free",
  // "access": the app installs only behind Cloudflare Access (below).
  "requires": ["zone", "email-routing", "access"],
  // No sign-in at all, and anyone who reaches the app can list the verified
  // destination addresses and create or delete forwarding rules; upstream
  // expects Cloudflare Access in front of the whole app, so protection is
  // required. The cron trigger is not a request, so Access does not stand in
  // its way, and nothing else must stay public.
  "access": { "mode": "required" },
  "secrets": [
    {
      "name": "CLOUDFLARE_API_TOKEN",
      "label": "Cloudflare API token for Dispoflare",
      "help": "A token you create for the app, separate from Appflare's, with these permissions: Account, Email Routing Addresses, Read; Zone, Email Routing Rules, Edit; Zone, Zone, Read; Zone, Zone Settings, Read. Limit its zone resources to the domains you want addresses on. Paste the token secret only, without \"Bearer\".",
      "cloudflareToken": true
    }
  ],
  "vars": [
    {
      "name": "CLOUDFLARE_ACCOUNT_ID",
      "label": "Account ID",
      "help": "The account whose verified destination addresses the app forwards to: this one.",
      "default": "{{accountId}}"
    },
    {
      "name": "SENTRY_DSN",
      "label": "Sentry DSN",
      "help": "Reports the Worker's errors to Sentry. Leave empty to only log them.",
      "link": {
        "label": "Find your DSN",
        "url": "https://docs.sentry.io/concepts/key-terms/dsn-explainer/"
      },
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "**Dispoflare has no sign-in of its own**, so Appflare keeps it behind Cloudflare Access: only the people who use this Appflare can reach {{appUrl}}, list your verified destination addresses, and create or delete forwarding addresses on your domains."
    },
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and sign in through Cloudflare Access. It lists the zones where Email Routing is on and the destination addresses verified under Email Routing, Destination addresses; add and verify your own inbox there first. Create an address, pick the inbox it forwards to and its expiry date, and see them all under Manage."
    },
    {
      "type": "markdown",
      "content": "Twice a day the Worker turns off addresses past their expiry date, and deletes those created with automatic removal a month after that. The Settings page is unfinished upstream and does not save."
    }
  ],
  // What the app's own Cloudflare API calls need, by Cloudflare's API
  // reference and upstream's token template in its README.
  "tokenPermissions": [
    {
      "group": "Email Routing Addresses",
      "scope": "account",
      "access": "read",
      "reason": "Lists the verified destination addresses an address can forward to."
    },
    {
      "group": "Email Routing Rules",
      "scope": "zone",
      "access": "edit",
      "reason": "Creates, turns off and deletes the routing rule behind each disposable address."
    },
    {
      "group": "Zone",
      "scope": "zone",
      "access": "read",
      "reason": "Lists your zones."
    },
    {
      "group": "Zone Settings",
      "scope": "zone",
      "access": "read",
      "reason": "Checks which zones have Email Routing turned on."
    }
  ]
}
