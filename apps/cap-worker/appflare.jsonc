{
  // A backend for Cap, the proof-of-work CAPTCHA: the Worker issues and checks
  // SHA-256 challenges and one SQLite Durable Object holds the open challenges
  // and redeemed tokens, pruned by an alarm every minute.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "cap-worker",
  "name": "Cap Worker",
  "summary": "A self-hosted backend for Cap, the privacy-friendly proof-of-work CAPTCHA: your sites get challenges and verify tokens against your own Worker, with no tracking.",
  "homepage": "https://github.com/xyTom/cap-worker",
  "repo": "xyTom/cap-worker",
  // The repository has no LICENSE file; its README states "This project is
  // licensed under the MIT License."
  "license": "MIT",
  "categories": ["security", "developer-tools"],
  "authors": [{ "name": "xyTom", "github": "xyTom" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no tags; the pin follows the default branch.
  "source": { "ref": "main", "sha": "39eb690b47eddeb1f348cdb19e06e8c023f72e6b" },
  "install": {
    "tier": "artifact",
    "packageManager": "npm",
    // TypeScript that wrangler bundles, plus a static docs page and the Cap
    // widget script in public/: no build step. Upstream's `workers_dev: false`
    // is dropped like any route setting; the manager decides the address.
    "wranglerConfig": "wrangler.jsonc",
    "workerName": "cap-worker"
  },
  // A SQLite-backed Durable Object and static assets fit the free plan; the
  // cleanup alarm adds about 1,440 Durable Object requests a day.
  "plan": "free",
  "requires": [],
  // The Worker reads no secrets or settings. Its API is open to any site, as
  // upstream's is: a token proves that a challenge was solved, not where.
  "secrets": [],
  "vars": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Point the Cap widget at this install: load {{workerUrl}}/cap.min.js and set `data-cap-api-endpoint=\"{{workerUrl}}/api/\"` on `<cap-widget>`. Your server then checks each token with `POST {{workerUrl}}/api/validate`."
    },
    {
      "type": "markdown",
      "content": "The page at {{workerUrl}} is upstream's documentation. Its live demo and code samples use upstream's public server, captcha.gurl.eu.org, not this install; replace that address with {{workerUrl}} when you copy them."
    }
  ],
  "tokenPermissions": []
}
