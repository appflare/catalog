{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "feedlog",
  "name": "FeedLog",
  "summary": "Feedback boards, a public roadmap and an AI-assisted changelog for your product, with an embeddable widget. Runs on Workers with R2 for uploads and your own Postgres through Hyperdrive.",
  "homepage": "https://feedlog.ai",
  "repo": "linkcraftstudio/feedlog",
  "license": "MIT",
  "categories": ["business", "productivity"],
  "authors": [
    { "name": "LinkCraft Studio", "url": "https://feedlog.ai", "github": "linkcraftstudio" },
    { "name": "guoliim", "github": "guoliim" },
    { "name": "Jeff", "github": "canghai118", "x": "lastz321" }
  ],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.5.0", "sha": "44dd5b593e225e8afc1a35b94780f4031ce2d668" },
  "install": {
    "tier": "artifact",
    "packageManager": "pnpm",
    // The root config has no `main`: the Nuxt build (Nitro's cloudflare-module
    // preset) writes the Worker and its deploy config under .output and points
    // wrangler at it through .wrangler/deploy/config.json, which the packer
    // follows as `wrangler deploy` does.
    "wranglerConfig": "wrangler.toml",
    "workerName": "feedlog",
    // Upstream's Workers build: `nuxt build` with NITRO_PRESET=cloudflare-module,
    // then the Drizzle migrations are copied next to the server bundle, where
    // the Worker reads them as Text modules on its first request.
    "buildCommand": "pnpm run build:cf"
  },
  // Workers, R2 and Hyperdrive all have free tiers. The Postgres database runs
  // elsewhere (Neon and Supabase have free tiers too).
  "plan": "free",
  "requires": ["r2"],
  "resources": {
    "hyperdrive": [
      {
        "binding": "POSTGRES",
        "protocol": "postgres",
        "label": "Postgres database",
        "help": "PostgreSQL 17 or later, reachable from the internet, with the vector extension enabled (CREATE EXTENSION IF NOT EXISTS vector;). FeedLog creates its tables on the first visit."
      }
    ]
  },
  // Seeded from upstream's .dev.vars.example (the two the Deploy button asks
  // for) and .env.example (the optional sign-in, AI and mail settings).
  "secrets": [
    {
      "name": "BETTER_AUTH_SECRET",
      "label": "Session secret",
      "help": "Encrypts sessions and cookies. Setting a new value signs everyone out.",
      "generate": true
    },
    {
      "name": "SYSTEM_ADMIN_EMAILS",
      "label": "Admin emails",
      "help": "The first sign-up with one of these addresses becomes an admin. Comma separated, for example you@example.com."
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret",
      "help": "For Google sign-in, with the client ID below. The OAuth client's redirect URI is {{workerUrl}}/api/auth/callback/google.",
      "optional": true
    },
    {
      "name": "GITHUB_CLIENT_SECRET",
      "label": "GitHub OAuth client secret",
      "help": "For GitHub sign-in, with the client ID below. The OAuth app's callback URL is {{workerUrl}}/api/auth/callback/github.",
      "optional": true
    },
    {
      "name": "OPENAI_API_KEY",
      "label": "OpenAI API key",
      "help": "Turns on similar-idea detection and AI-drafted changelog entries. Any OpenAI-compatible API works; see the base URL below.",
      "optional": true
    },
    {
      "name": "RESEND_API_KEY",
      "label": "Resend API key",
      "help": "Sends password-reset and verification mail through Resend, from the sender address below. Setting it also turns on email verification at sign-up. Without it, mail is only logged.",
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "BETTER_AUTH_URL",
      "label": "Public URL",
      "help": "Where people open FeedLog, without a trailing slash. OAuth callbacks and links in notifications use it.",
      "default": "{{workerUrl}}"
    },
    {
      "name": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID",
      "help": "For Google sign-in. With neither Google nor GitHub set up, email and password sign-in is on."
    },
    {
      "name": "GITHUB_CLIENT_ID",
      "label": "GitHub OAuth client ID",
      "help": "For GitHub sign-in."
    },
    {
      "name": "OPENAI_BASE_URL",
      "label": "OpenAI-compatible base URL",
      "help": "Leave empty for https://api.openai.com/v1."
    },
    {
      "name": "OPENAI_TEXT_MODEL",
      "label": "Chat model",
      "help": "The model that drafts changelog entries. Leave empty for upstream's default."
    },
    {
      "name": "EMAIL_FROM",
      "label": "Sender address",
      "help": "The address FeedLog mails come from, on a domain verified with your email provider, for example noreply@example.com."
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{workerUrl}}. On the first visit FeedLog creates its tables in your database and returns to the app; if that stops with an error, check that the vector extension is enabled."
    },
    {
      "type": "markdown",
      "content": "Then sign up with an address from **Admin emails** to become an admin. Email and password sign-in is on until you set up Google or GitHub sign-in."
    },
    {
      "type": "markdown",
      "content": "After an update that brings new database migrations, sign in as an admin and open {{workerUrl}}/setup to apply them."
    }
  ],
  "tokenPermissions": []
}
