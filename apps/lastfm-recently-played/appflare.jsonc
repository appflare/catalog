{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "lastfm-recently-played",
  "name": "Last.fm Recently Played",
  "summary": "An SVG card of your recent Last.fm scrobbles for a GitHub profile README, with themes, artwork, stats and loved tracks, plus a configurator page to build the card's URL.",
  "tagline": "Show your recent music on your GitHub profile",
  "homepage": "https://lastfm-recently-played.jeffreyca.workers.dev",
  "repo": "JeffreyCA/lastfm-recently-played-readme",
  "license": "MIT",
  "categories": ["media", "utilities"],
  // Field links added after this release was published: a revision, no new build.
  "revision": 3,
  "authors": [{ "name": "JeffreyCA", "github": "JeffreyCA" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags; the pin is the head of main.
  "source": { "ref": "main", "sha": "cce76de9b974f6f5155254b4fd6f710949470965" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.jsonc",
    // Answers 200 whether or not the API key is set.
    "health": { "path": "/api/health" }
  },
  // One Worker, its configurator page as static assets, and the Workers
  // cache in front of it; no storage.
  "plan": "free",
  "secrets": [
    {
      "name": "LASTFM_API_KEY",
      "label": "Last.fm API key",
      "help": "Create an API account at https://www.last.fm/api/account/create and copy its API key; the shared secret is not needed.",
      "link": { "label": "Get a key", "url": "https://www.last.fm/api/account/create" }
    }
  ],
  // UPSTREAM_CACHE_SECONDS (60) and ART_CACHE_SECONDS (86400) keep upstream's
  // values.
  "vars": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Build a card at {{appUrl}}, or add `![My scrobbles]({{appUrl}}/svg?user=<your Last.fm user name>)` to a README. GitHub caches README images, so new scrobbles can take a few minutes to show."
    }
  ]
}
