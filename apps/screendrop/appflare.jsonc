{
  // The cloud side of Screendrop, a macOS screenshot and screen recording
  // app: the app uploads each capture here and gets a share link back.
  // Screenshots get a viewer page, recordings a share page with a player,
  // transcript, comments and likes.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "screendrop",
  "name": "Screendrop Cloud",
  "summary": "The upload and sharing backend for the Screendrop macOS app: screenshots and screen recordings stored in R2, with share pages, transcripts, comments and likes.",
  "tagline": "Share screenshots and screen recordings with your own links",
  "repo": "fayazara/screendrop-worker",
  // The repository has no LICENSE file; its README's License section says MIT.
  "license": "MIT",
  "categories": ["sharing", "media"],
  // Field links added after this release was published: a revision, no new build.
  "revision": 2,
  "authors": [{ "name": "Fayaz Ahmed", "github": "fayazara", "x": "fayazara" }],
  "maintainers": ["MendyLanda"],
  // Upstream publishes no release tags; the pin tracks main, which the
  // Screendrop app compares against through /api/version.
  "source": { "ref": "main", "sha": "32a8898dac62da1b190dd9edcb63d22a2049a257" },
  "install": {
    "packageManager": "pnpm",
    // TanStack Start through the Cloudflare Vite plugin, which writes the
    // Worker and the config wrangler deploys from under dist/ and points
    // wrangler at it; the packer follows that redirect. The Drizzle
    // migrations stay in drizzle/, the config's migrations_dir beside
    // wrangler.jsonc. The Worker's own /api/setup creates the same tables
    // with IF NOT EXISTS, so it agrees with a database migrated this way.
    "wranglerConfig": "wrangler.jsonc",
    // Upstream's build script (vite build); the config has no build.command.
    "buildCommand": "pnpm run build"
  },
  // D1 for metadata and R2 for the captures, both on their free tiers; R2's
  // 10 GB is the limit that matters for recordings.
  "plan": "free",
  "requires": ["r2"],
  // From upstream's .dev.vars.example and its README's secrets table.
  "secrets": [
    {
      "name": "UPLOAD_TOKEN",
      "label": "Upload token",
      "help": "The token the Screendrop app generated under Settings, Cloud: copy it from there and paste it here. The app sends it with every upload, and it also signs comment sign-in sessions unless the session key below is set."
    },
    {
      "name": "AUTH_SECRET",
      "label": "Session key",
      "help": "Signs the cookies of viewers who sign in to comment, so they do not depend on the upload token. Setting a new value signs every viewer out.",
      "generate": "password"
    },
    {
      "name": "GITHUB_CLIENT_SECRET",
      "label": "GitHub OAuth client secret",
      "help": "For \"Sign in with GitHub\" on share pages, with the client ID below. The OAuth app's callback URL is the app's address followed by /api/auth/callback/github.",
      "link": {
        "label": "Create an OAuth app",
        "url": "https://github.com/settings/applications/new"
      },
      "optional": true
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret",
      "help": "For \"Sign in with Google\" on share pages, with the client ID below. The OAuth client's redirect URI is the app's address followed by /api/auth/callback/google.",
      "link": {
        "label": "Create an OAuth client",
        "url": "https://console.cloud.google.com/apis/credentials"
      },
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "AUTHOR_NAME",
      "label": "Your name",
      "help": "Shown on share pages as the person who shared the capture. Leave empty for Anonymous.",
      "optional": true
    },
    {
      "name": "AUTHOR_AVATAR",
      "label": "Avatar URL",
      "help": "An image shown next to your name, for example https://github.com/your-username.png. Leave empty for a generated avatar.",
      "optional": true
    },
    {
      "name": "GITHUB_CLIENT_ID",
      "label": "GitHub OAuth client ID",
      "help": "Comments and likes need a signed-in viewer. Set up GitHub, Google, or both; without either, share pages show no comments or likes.",
      "link": {
        "label": "Create an OAuth app",
        "url": "https://github.com/settings/applications/new"
      },
      "optional": true
    },
    {
      "name": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID",
      "help": "A Web application OAuth client. Publish its consent screen, or only its test users can sign in.",
      "link": {
        "label": "Create an OAuth client",
        "url": "https://console.cloud.google.com/apis/credentials"
      },
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "In the Screendrop app, open Settings, Cloud, enter {{appUrl}} as the worker URL and choose Verify Connection. Captures you share from then on upload here and get links under {{appUrl}}."
    },
    {
      "type": "markdown",
      "content": "Share pages are public to anyone with the link. Uploading and deleting need the upload token."
    }
  ]
}
