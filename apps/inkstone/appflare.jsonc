{
  // A Markdown notebook on one Worker: D1 holds accounts, notes and search
  // indexes, R2 the attachments, KV the MCP OAuth grants, and two SQLite
  // Durable Objects carry realtime sync and the backup credentials key. The
  // Worker creates and upgrades its own tables on first request.
  //
  // The wrangler config declares both Durable Object classes with an
  // `exports` block instead of `migrations`. The artifact carries that block
  // and the manager sends it with the upload, as wrangler does; Cloudflare
  // then creates the classes. That path has not yet been exercised on a live
  // install by this entry's maintainers.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "inkstone",
  "name": "Inkstone",
  "summary": "A self-hosted Markdown notebook with live preview, backlinks, full-text and semantic search, offline editing, multi-device sync, public sharing, MCP access and scheduled backups.",
  "tagline": "A private notebook for writing, finding, and syncing notes",
  "features": [
    "Write Markdown with live preview and recover earlier versions",
    "Organize notes with folders, tags, backlinks and a relationship graph",
    "Find notes by their words or meaning",
    "Edit offline and sync changes across devices",
    "Share notes with optional passwords and expiration dates",
    "Export notes and schedule backups to WebDAV or S3 storage"
  ],
  "alternativeTo": ["Obsidian", "Joplin"],
  "repo": "shuaiplus/inkstone",
  "homepage": "https://inkstone-demo.pages.dev/",
  // The LICENSE file holds the LGPL-3.0 text followed by the GPL-3.0 text it
  // builds on; README and package.json say LGPL-3.0-only.
  "license": "LGPL-3.0-only",
  "categories": ["notes", "productivity"],
  "revision": 3,
  "authors": [{ "name": "Shuai", "url": "https://shuai.plus", "github": "shuaiplus" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.8.0", "sha": "c146593f0c2153431433260d0377622906f17e42" },
  "install": {
    "packageManager": "npm",
    // The R2 variant. The Vite build writes the deployable config under
    // dist/inkstone and points wrangler at it.
    "wranglerConfig": "wrangler.toml",
    // Type-checks, then builds the client and the Worker.
    "buildCommand": "npm run build"
  },
  // D1, R2, KV, SQLite Durable Objects, Workers AI and two cron triggers (the
  // hourly and half-hourly background jobs) all have free tiers.
  "plan": "free",
  // Attachments go to R2; semantic search uses Workers AI and falls back to
  // full-text search where it is unavailable.
  "requires": ["r2", "workers-ai"],
  "vars": [
    {
      "name": "APP_NAME",
      "label": "Site name",
      "help": "Shown in the app, on shared notes, and as the issuer in authenticator apps.",
      "default": "Inkstone"
    },
    {
      "name": "PUBLIC_URL",
      "label": "Public URL",
      "help": "The https address MCP clients and OAuth use, such as a custom domain. Leave it empty to use the address each request arrives at.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and register right away: the first account becomes the owner. Later sign-ups are closed unless the owner opens registration in the settings."
    }
  ]
}
