{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "projektor",
  "name": "Projektor",
  "summary": "An issue tracker and wiki for teams and their AI coding agents: issues, boards, sprints and pages in the browser, and the same actions over MCP.",
  "tagline": "Track team issues and keep a wiki alongside AI coding agents",
  "homepage": "https://tajd.github.io/projektor/",
  "repo": "TAJD/projektor",
  "license": "MIT",
  "categories": ["productivity", "developer-tools", "ai"],
  "authors": [{ "name": "Thomas Dickson", "url": "https://tom-dickson.com", "github": "TAJD" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.7.6", "sha": "f25010ebd7fc68249f3038ab16041d9ca61283da" },
  "install": {
    "packageManager": "pnpm",
    // The API Worker, which also serves the web app as static assets.
    "wranglerConfig": "apps/api/wrangler.toml",
    // Upstream's web build (Astro, then its service worker check and the
    // Content-Security-Policy _headers file), copied beside the API Worker's
    // config so its assets directory stays inside that folder, as upstream's
    // release bundle ships it.
    "buildCommand": ["pnpm --filter @projektor/web run build", "cp -r apps/web/dist apps/api/web"],
    // Answers without a sign-in, from the Worker's own code.
    "health": { "path": "/api/health" },
    // The repository's config is the one for local development. Upstream's
    // release config (scripts/release-assets/wrangler.example.toml) adds the
    // web app as static assets, with the routes the Worker answers first, and
    // runs without ENVIRONMENT = "development", which turns on upstream's
    // development-only sign-in and setup routes. Without it the app runs as
    // in production. No upstream pull request yet.
    "configPatch": {
      "assets": {
        "directory": "web",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/mcp/*", "/wiki", "/.well-known/*"]
      },
      "vars": { "ENVIRONMENT": null }
    }
  },
  // D1, two KV namespaces, R2, the SQLite-backed rate limiter Durable Object
  // and one daily cron fit the free plan. The optional real-time hub's
  // binding is left out, as upstream's config does.
  "plan": "free",
  "requires": ["r2", "access"],
  // People sign in only through Cloudflare Access (apps/api/src/middleware/
  // auth.ts tryCfAccessAuth), so the app installs only behind Appflare's
  // Access application. These paths stay public for MCP clients, which carry
  // no Access session: OAuth discovery and the token endpoint, as upstream's
  // MCP guide lists them (apps/docs/.../agents/mcp-connection.md, "two paths
  // must bypass"), and the MCP endpoint itself, which checks its own OAuth or
  // pk_ bearer tokens (auth.ts authMiddleware) and refuses Access service
  // tokens, the only other way past Appflare's policy. Upstream keeps /mcp
  // behind Access and gives MCP clients an Access service token; Appflare's
  // policy admits only Appflare's users and its own health-check token, so
  // /mcp is public here and relies on the app's own check. /oauth/authorize,
  // the consent screen, stays behind Access.
  "access": { "mode": "required", "bypass": ["/.well-known/*", "/oauth/token", "/mcp/*"] },
  "secrets": [
    {
      "name": "JWT_SECRET",
      "label": "Signing secret",
      "help": "Signs the OAuth consent flow that connects Claude and other MCP clients.",
      "generate": "password"
    }
  ],
  "vars": [
    {
      // Without https://: auth.ts prefixes it for the issuer and the certs URL.
      "name": "CF_ACCESS_TEAM_DOMAIN",
      "label": "Cloudflare Access team domain",
      "help": "Filled in by Appflare from the app's Cloudflare Access protection: your Zero Trust team domain. The app checks each sign-in's Access token against it.",
      "default": "{{accessTeamDomain}}"
    },
    {
      "name": "CF_ACCESS_AUDIENCE",
      "label": "Cloudflare Access audience (AUD) tag",
      "help": "Filled in by Appflare: the audience tag of the app's Cloudflare Access application.",
      "default": "{{accessAud}}"
    },
    {
      "name": "ADMIN_EMAILS",
      "label": "Admin emails",
      "help": "Comma-separated emails that become workspace owners. The first of them to sign in creates the default workspace.",
      // The config's value is upstream's development address; an empty
      // default makes the form ask for real ones.
      "default": ""
    },
    {
      "name": "AUTO_JOIN_ROLE",
      "label": "Role for other people",
      "help": "What every other Appflare user gets in the default workspace when they first sign in.",
      "type": "select",
      "options": [
        { "value": "none", "label": "Nothing: invite only" },
        { "value": "viewer", "label": "Viewer" },
        { "value": "member", "label": "Member" },
        { "value": "admin", "label": "Admin" }
      ],
      "default": "none",
      "optional": true
    },
    {
      "name": "DEFAULT_WORKSPACE_NAME",
      "label": "Workspace name",
      "help": "The name of the workspace the first admin creates.",
      "default": "Projektor",
      "optional": true
    },
    {
      "name": "DEFAULT_WORKSPACE_SLUG",
      "label": "Workspace slug",
      "help": "The short id of that workspace, in lowercase letters, digits and hyphens.",
      "default": "projektor",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and sign in through Cloudflare Access with one of the admin emails: the first admin creates the default workspace. The database is already migrated. Every Appflare user can sign in; what they get depends on **Role for other people**."
    },
    {
      "type": "markdown",
      "content": "To connect Claude or another MCP client, add `{{appUrl}}/mcp/<workspace id>` as a connector and approve it in the browser. Discovery, the token endpoint and the MCP endpoint answer without Access; the consent screen stays behind it. Upstream's [MCP guide](https://tajd.github.io/projektor/agents/mcp-connection/) has the details."
    }
  ]
}
