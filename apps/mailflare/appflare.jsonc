{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "mailflare",
  "name": "Mailflare",
  "summary": "A self-hosted email service for your own domains: mailboxes, forwarding rules, and a web inbox, on Email Routing, D1, R2, Queues, and Durable Objects. Shared inboxes require a paid Team license.",
  "tagline": "Receive, send and organize email on your own domain",
  "features": [
    "Create mailboxes and aliases across multiple domains",
    "Send messages with attachments, rich text and signatures",
    "Organize mail with folders, search, stars and snoozing",
    "Forward, reject or sort incoming mail with rules",
    "Back up your mailbox and import or export mail",
    "Connect compatible desktop and mobile email apps through JMAP"
  ],
  "alternativeTo": ["Gmail"],
  "homepage": "https://mailflare.co",
  "repo": "hieunc229/mailflare",
  // The LICENSE file's Mailflare notice grants GNU AGPL version 3 or any later version.
  "license": "AGPL-3.0-or-later",
  "categories": ["email"],
  // Help text (revision 2) and catalog metadata (revision 3) changed after
  // this release was published: revisions, no new build.
  // Features and alternatives (revision 4).
  "revision": 4,
  "authors": [{ "name": "Hieu Nguyen", "github": "hieunc229", "x": "hieuSSR" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags, so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "6978c01de1ff5da68ee6e037414b134bf3bba008" },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.jsonc",
    // The app creates its Email Routing rules for the Worker named "mailflare"
    // (getEmailWorkerName() in src/lib/cloudflare-api-utils.ts returns the
    // literal), so mail only reaches an install under that name. Its
    // WORKER_SELF_REFERENCE service binding does not need it: the installer
    // points that binding at whatever name the Worker has.
    "fixedWorkerName": true,
    // Upstream's deploy script: the app's own `build` script bundles the D1
    // migrations into the app, then `vite build` (vinext with the Cloudflare
    // Vite plugin) writes the Worker and its assets to dist/ and leaves the
    // redirect wrangler deploys from. The wrangler config has no
    // build.command.
    "buildCommand": "npm run build",
    // Unauthenticated, reads D1 (so it also shows the migrations were applied),
    // and answers 200 before the first admin exists.
    "health": { "path": "/api/setup/status" }
    // No `emailRouting`: the app turns Email Routing on and creates its rules
    // itself, per domain and mailbox, with CF_TOKEN.
  },
  // Receiving mail, D1, R2, Queues, and SQLite Durable Objects have free tiers,
  // but sending is half of what the app is for, and upstream requires Workers
  // Paid for it: Email Sending, needed for any address other than the
  // account's verified destinations, is not offered on the free plan.
  "plan": "paid",
  "requires": ["zone", "email-routing", "r2"],
  "secrets": [
    {
      "name": "CF_TOKEN",
      "label": "Cloudflare API token for Mailflare",
      "help": "A token you create for the app, separate from Appflare's, with the permissions listed below: Zone Read, DNS Edit, Zone Settings Edit, and Email Routing Rules Edit on the zones you will connect, plus the account's Email Sending Edit to send mail. Paste the token secret only, without \"Bearer\".",
      "cloudflareToken": true
    }
    // Not asked for: TURNSTILE_SECRET_KEY needs NEXT_PUBLIC_TURNSTILE_SITE_KEY
    // at build time, which a catalog build does not have, so setting it would
    // lock everyone out of sign-in. GITHUB_UPDATE_* dispatch upstream's own
    // update workflow; Appflare updates the app instead. INBOUND_WEBHOOK_SECRET
    // and the SMTP_* settings belong to the Docker relay mode.
  ],
  "vars": [
    {
      "name": "APP_URL",
      "label": "Public URL",
      "help": "The address people open the app at, used in password-reset links and JMAP. Leave it empty to use the address of each request.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/setup to check the configuration and create the first admin account. The database is already migrated."
    },
    {
      "type": "markdown",
      "content": "Then add a domain that uses Cloudflare DNS in this account. Mailflare turns on Email Routing for it, sets up the MX and sending records it needs, and routes each mailbox you create to this Worker."
    },
    {
      "type": "markdown",
      "content": "Sending to arbitrary recipients needs Workers Paid with Email Sending turned on for the domain, and the account's Email Sending Edit on CF_TOKEN."
    }
  ],
  // What the app's own Cloudflare API calls need, by Cloudflare's API schema:
  // zone lookup (Zone Read), MX and sending records (DNS Edit), turning Email
  // Routing on for a zone (filed under Zone Settings), routing rules and the
  // catch-all (Email Routing Rules), and sending subdomains (Email Sending,
  // an account permission). Upstream's docs also name DNS Settings and Email
  // Routing Addresses, which the app never calls.
  "tokenPermissions": [
    {
      "group": "Zone",
      "scope": "zone",
      "access": "read",
      "reason": "Finds the zone of each domain you connect."
    },
    {
      "group": "DNS",
      "scope": "zone",
      "access": "edit",
      "reason": "Writes the MX and sending records, replacing conflicting MX records after you confirm."
    },
    {
      "group": "Zone Settings",
      "scope": "zone",
      "access": "edit",
      "reason": "Turns Email Routing on for a connected domain."
    },
    {
      "group": "Email Routing Rules",
      "scope": "zone",
      "access": "edit",
      "reason": "Routes each mailbox address, or the catch-all, to the Worker."
    },
    {
      "group": "Email Sending",
      "scope": "account",
      "access": "edit",
      "reason": "Optional: sets the domain up for outbound mail through Email Sending."
    }
  ]
}
