{
  // Upstream deploys four Workers with plain wrangler, one per directory: the
  // SvelteKit console at the root, and one agent Worker each for auth, the
  // database and storage under agents/. The console reaches every agent over
  // a service binding and proxies the apps' API calls to them, so the agents
  // need no public address. Upstream renamed the project from Cloudflarebase
  // to Frostbase; the slug stays.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "cloudflarebase",
  "name": "Frostbase",
  "summary": "An open-source Firebase alternative on Cloudflare: auth, JSON collections and SQL tables with live queries, remote config and file storage, each project in Durable Objects of its own, run from one console.",
  "tagline": "Add sign-in, live data, and file storage to your app",
  "features": [
    "Add email and password sign-in to your apps",
    "Store app data in collections or tables",
    "Update connected apps as their data changes",
    "Change app settings and feature flags without publishing a new version",
    "Upload files and choose who can access them"
  ],
  "alternativeTo": ["Firebase"],
  "homepage": "https://frostbase.dev",
  "repo": "frostbase-dev/frostbase",
  "license": "Apache-2.0",
  "categories": ["developer-tools", "files"],
  "authors": [
    {
      "name": "The Frostbase Authors",
      "url": "https://frostbase.dev",
      "github": "frostbase-dev"
    }
  ],
  "maintainers": ["MendyLanda"],
  // Pinned to main: the repository has no tags.
  "source": {
    "ref": "main",
    "sha": "2ed6e45cedb3d3c38a1b5c3ce05ca1827fe68f2c"
  },
  "install": {
    "packageManager": "npm",
    "wranglerConfig": "wrangler.jsonc",
    // The root install's postinstall runs `npm install` in each agent
    // directory; installs here run without scripts, so each agent directory,
    // which has a lockfile of its own, is listed instead.
    "installDirs": [
      { "path": "." },
      { "path": "agents/auth" },
      { "path": "agents/db" },
      { "path": "agents/storage" }
    ],
    // `vite build` syncs SvelteKit's generated files itself and writes the
    // Worker and its assets to .svelte-kit/cloudflare. The agents are bundled
    // by wrangler from their sources.
    "buildCommand": "npm run build",
    "workers": [
      { "name": "dashboard", "wranglerConfig": "wrangler.jsonc", "primary": true },
      // The agents' operator routes carry no authentication of their own: the
      // console's guard in front of them is the gate, which is why upstream
      // turns their workers.dev URLs off too.
      { "name": "auth", "wranglerConfig": "agents/auth/wrangler.jsonc", "workersDev": false },
      { "name": "db", "wranglerConfig": "agents/db/wrangler.jsonc", "workersDev": false },
      {
        "name": "storage",
        "wranglerConfig": "agents/storage/wrangler.jsonc",
        "workersDev": false,
        // Upstream leaves the R2 binding out of its default config, so a
        // deploy works on an account without R2, and the agent answers file
        // requests with a 503 until one is added. The install provisions the
        // bucket instead.
        "configPatch": { "r2_buckets": [{ "binding": "BUCKET" }] }
      }
    ]
  },
  // D1, R2, Durable Objects, Workers AI (the project copilot) and Analytics
  // Engine (database events) all have free tiers, and managers from 0.4.0
  // install four Workers on Workers Free.
  "plan": "free",
  // The db agent writes database events to an Analytics Engine dataset, and
  // Cloudflare refuses the upload on an account that has not turned
  // Analytics Engine on.
  "requires": ["r2", "workers-ai", "analytics-engine"],
  "secrets": [
    {
      "name": "CONSOLE_SETUP_TOKEN",
      "label": "Console setup token",
      "help": "Paste it on the console's sign-in page to create the first operator account. It also lets you reclaim the console later. At least 24 characters.",
      "generate": "password",
      "workers": ["dashboard"]
    }
  ],
  "vars": [
    {
      "name": "EMAIL_FROM",
      "label": "Sender address",
      "help": "The address the auth agent sends verification and password-reset mail from, through Cloudflare Email Sending. Leave it empty to send no mail.",
      "workers": ["auth"],
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/login and paste the console setup token to create the first operator account, then create a project. Apps call its API at `{{appUrl}}/api/projects/<project id>`."
    }
  ]
}
