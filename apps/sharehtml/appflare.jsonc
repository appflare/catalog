{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "sharehtml",
  "name": "ShareHTML",
  "summary": "Publish HTML, Markdown, and code files from the command line and get a shareable link with live comments, reactions, and presence. Sign-in through Cloudflare Access.",
  "tagline": "Publish web pages and documents by link and gather comments",
  "repo": "jonesphillip/sharehtml",
  "license": "Apache-2.0",
  "categories": ["files", "sharing"],
  "authors": [{ "name": "Phillip Jones", "github": "jonesphillip", "x": "akaphill" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no release tags, so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "27ddaaf191b535346453134fd693e2295a38b88f" },
  "install": {
    "packageManager": "pnpm",
    // The Worker package of the pnpm monorepo (the CLI in apps/cli is
    // installed on the user's machine, not deployed). Cloudflare's Vite plugin
    // writes the bundled Worker and its deploy config under dist/ and points
    // wrangler at it; the packer follows that redirect. The build uses the
    // config's top-level environment; its production environment differs only
    // in names and in the auth vars, which the form below sets.
    "wranglerConfig": "apps/worker/wrangler.jsonc",
    // The Worker package's build script; the wrangler config has no build.command.
    "buildCommand": "pnpm --filter @sharehtml/worker build",
    // Answers before the sign-in check, from the Worker's own code.
    "health": { "path": "/health" }
  },
  // R2 and two SQLite-backed Durable Objects, all with free tiers. Cloudflare
  // Access is free for up to 50 users.
  "plan": "free",
  // Uploaded documents are stored in an R2 bucket.
  "requires": ["r2"],
  "secrets": [
    {
      "name": "VIEWER_CAPABILITY_SECRET",
      "label": "Viewer signing secret",
      "help": "Signs the short-lived tokens the viewer page hands to its own scripts, so a document's JavaScript cannot act for the signed-in reader.",
      "generate": "password"
    }
  ],
  "vars": [
    {
      "name": "AUTH_MODE",
      "label": "Sign-in",
      "help": "With Cloudflare Access, the Worker checks the Access token on every request and refuses everything until the two Access values below are set. Without sign-in, anyone with the address can publish, read, and comment.",
      "type": "select",
      "options": [
        { "value": "access", "label": "Cloudflare Access" },
        { "value": "none", "label": "No sign-in (open to anyone with the address)" }
      ],
      "default": "access"
    },
    {
      "name": "ACCESS_TEAM",
      "label": "Access team name",
      "help": "Your Zero Trust team name: the <team> in <team>.cloudflareaccess.com. Set it here after turning on Access for the Worker (see the steps after installing).",
      "optional": true,
      "default": ""
    },
    {
      "name": "ACCESS_AUD",
      "label": "Access application audience (AUD)",
      "help": "The AUD tag of the Access application that protects the Worker. Set it here after turning on Access for the Worker.",
      "optional": true,
      "default": ""
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "**With Cloudflare Access sign-in, every page answers 401 until Access protects the Worker.** In the Cloudflare dashboard, open Workers & Pages, select this Worker, open Settings, Domains & Routes, and turn on Cloudflare Access for its workers.dev address. Then enter the team name and the application audience (AUD) tag it shows under **Access team name** and **Access application audience** in this app's settings."
    },
    {
      "type": "markdown",
      "content": "Install the command-line tool (it needs [Bun](https://bun.sh)), point it at the Worker, and publish a file:\n\n```sh\nnpm install -g sharehtml\nsharehtml config set-url {{appUrl}}\nsharehtml login\nsharehtml deploy report.html\n```"
    }
  ]
}
