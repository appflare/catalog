{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "renewlet",
  "name": "Renewlet",
  "summary": "Track recurring subscriptions and renewals: timezone-aware reminders over ten notification channels, calendar feeds, budgets, cost sharing and spending statistics, on D1, R2 and a queue.",
  "tagline": "Track subscriptions and get reminders before they renew",
  "homepage": "https://renewlet.cc",
  "repo": "zhiyingzzhou/renewlet",
  "license": "MIT",
  "categories": ["finance", "productivity"],
  "authors": [{ "name": "zhiyingzhou", "url": "https://renewlet.cc", "github": "zhiyingzzhou" }],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.3.27", "sha": "e7ae44aed1e749b2e43ed60b56738319afe16d50" },
  "install": {
    // A pnpm 11 workspace: the Worker in apps/worker, the React app in
    // apps/web, both installed from the root lockfile.
    "packageManager": "pnpm",
    "wranglerConfig": "wrangler.jsonc",
    // Upstream's Cloudflare build: the React app built for the Worker API
    // (the script sets VITE_RENEWLET_RUNTIME=cloudflare, which a build command
    // here cannot) into apps/web/dist, the assets directory, then a
    // `wrangler deploy --dry-run` of its own that the pack does again.
    "buildCommand": "pnpm run build:cloudflare",
    // Reads D1 without a session: it answers whether the first admin still
    // has to be created.
    "health": { "path": "/api/app/status" }
  },
  // D1, R2 and Queues all have free tiers. One cron trigger, every minute:
  // it sends the reminders due in each user's own timezone.
  "plan": "free",
  "requires": ["r2"],
  // No secrets: SMTP, Telegram and the other notification channels, the AI
  // provider keys and Turnstile are set per account in the app's settings
  // and stored in D1.
  "secrets": [],
  "vars": [
    {
      "name": "SESSION_TTL_DAYS",
      "label": "Session length in days",
      "help": "How long a sign-in lasts. Leave empty for 30 days.",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}}/setup right away and create the admin account: until someone does, the first visitor can."
    },
    {
      "type": "markdown",
      "content": "Set up email (SMTP), Telegram, Bark, webhooks and the other reminder channels under **Settings > Notifications**. Uploaded logos are stored in this app's R2 bucket."
    }
  ]
}
