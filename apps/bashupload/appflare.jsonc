{
  // A file drop you use from a terminal (curl host -T file) or a browser:
  // each upload gets a link, the file is deleted after its first download
  // or when its lifetime ends, and a cron trigger sweeps expired files out of
  // the R2 bucket every five minutes.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "bashupload",
  "name": "bashupload",
  "summary": "Upload a file from the terminal with curl or from a browser and get a link that works for one download or until it expires, with an optional password, on R2.",
  "tagline": "Share files from your browser or terminal with expiring links",
  "homepage": "https://bashupload.app",
  "repo": "DullJZ/bashupload-r2",
  // The repository has no LICENSE file and declares no licence anywhere, so
  // the catalog shows it as unlicensed.
  "license": "NONE",
  "categories": ["files", "sharing"],
  "authors": [{ "name": "DullJZ", "url": "https://www.jz-home.top", "github": "DullJZ" }],
  "maintainers": ["MendyLanda"],
  // Upstream's tags (bashupload-0.1.0, chart-v0.1.0) name its Docker image
  // and Helm chart, not the Worker, and are not versions the bump bot reads,
  // so the entry follows the default branch by commit.
  "source": { "ref": "main", "sha": "104901548e0b436fed269e445c4d23a0cfb043a6" },
  "install": {
    "packageManager": "npm",
    // No build: wrangler bundles src/index.js and serves public/ as static
    // assets through the Worker. Upstream's custom domain (bashupload.app)
    // is not part of the artifact, so the app answers at its workers.dev
    // address.
    "wranglerConfig": "wrangler.toml"
  },
  // R2, one rate limit and one cron trigger (every five minutes; the free
  // plan allows five per account) fit the free plan.
  "plan": "free",
  "requires": ["r2"],
  // The wrangler config sets PASSWORD in [vars] to an empty string; as a
  // secret here, that var is left out of the artifact.
  "secrets": [
    {
      "name": "PASSWORD",
      "label": "Password",
      "help": "Optional. When set, every upload and download must send it in the Authorization header (curl -H 'Authorization: <password>'), and the web page asks for it. Without it anyone who finds the address can upload files to your bucket.",
      "optional": true
    }
  ],
  "vars": [
    {
      "name": "MAX_UPLOAD_SIZE",
      "label": "Largest upload (bytes)",
      "help": "Upstream's default is 5 GB, but Cloudflare refuses request bodies over 100 MB on workers.dev and on Free and Pro zones, so the default here is 100 MB.",
      "default": "100000000"
    },
    {
      "name": "MAX_AGE",
      "label": "Lifetime of a one-time file (seconds)",
      "help": "A file nobody downloads is deleted after this long.",
      "default": "3600"
    },
    {
      "name": "MAX_AGE_FOR_MULTIDOWNLOAD",
      "label": "Longest lifetime an uploader may ask for (seconds)",
      "help": "An upload that sends X-Expiration-Seconds can be downloaded many times until it expires, up to this limit.",
      "default": "86400"
    },
    {
      "name": "ALLOW_LIFETIME_OVER_MAX_AGE",
      "label": "Allow longer lifetimes",
      "help": "Let uploaders ask for a lifetime above the limit above.",
      "type": "select",
      "options": [{ "value": "false", "label": "No" }, { "value": "true", "label": "Yes" }],
      "default": "false",
      "optional": true
    },
    {
      "name": "NO_CLEANUP",
      "label": "Keep expired files",
      "help": "Turn off the five-minute sweep that deletes expired files from the bucket.",
      "type": "select",
      "options": [
        { "value": "false", "label": "No, delete them" },
        { "value": "true", "label": "Yes, keep them" }
      ],
      "default": "false",
      "optional": true
    },
    {
      "name": "SHORT_URL_SERVICE",
      "label": "Short link service",
      "help": "A MyUrls endpoint used only for uploads to /short, which send the file's link to it. The default is the public instance upstream uses.",
      "default": "https://suosuo.de/short"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Upload from a terminal with `curl {{appUrl}} -T file.txt`, or open {{appUrl}} and drop a file. The link works for one download; send `-H 'X-Expiration-Seconds: 3600'` to allow downloads for an hour instead."
    },
    {
      "type": "markdown",
      "content": "Without a password, anyone who finds the address can store files in your R2 bucket, up to 10 uploads a minute per IP address. Set the password in this app's settings to keep it to yourself."
    }
  ]
}
