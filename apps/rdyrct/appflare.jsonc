{
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "rdyrct",
  "name": "rdyrct",
  "summary": "A URL shortener for teams: organizations with roles, branded short links and QR codes, click analytics that never store an IP, an MCP server, and a KV redirect path in front of D1.",
  "tagline": "Branded short links, QR codes, and private click analytics for teams",
  "features": [
    "Create short links with custom names and extra aliases",
    "Add source and campaign tags to the links you share",
    "See daily clicks by country, referrer and device without storing IP addresses",
    "Give teammates separate owner, admin and member roles"
  ],
  "alternativeTo": ["Bitly"],
  "homepage": "https://rdyrct.com",
  "repo": "baronunread/rdyrct",
  "license": "MIT",
  "categories": ["utilities", "analytics"],
  // Edited help text (revision 2), field links (revision 3) and the short link
  // host's default (revision 4) came after this release was published:
  // revisions, no new build.
  // Added features and alternatives (revision 5). 1.0.0: email and Polar
  // are optional (revision 6).
  "revision": 6,
  "authors": [
    {
      "name": "Andrea Bruno",
      "url": "https://brnr.dev",
      "github": "baronunread",
      "x": "baronunread"
    }
  ],
  "maintainers": ["MendyLanda", "baronunread"],
  "source": { "ref": "v1.0.0", "sha": "e9ba20e9bd2b65f9fbf7ed313b59e11fd90bd186" },
  "install": {
    "packageManager": "bun",
    // The config's KV, D1 and zone ids are upstream's production resources;
    // the ids are dropped when the artifact is packed, and the vars that name
    // upstream's own services are replaced below. The `playwright`
    // environment is for upstream's browser tests and is not used.
    "wranglerConfig": "wrangler.jsonc",
    // Upstream's `build` script: Vite with the Cloudflare plugin builds the
    // React app and the Worker together, and wrangler deploys the output.
    "buildCommand": "vite build",
    // Public deployment config, answered by the Worker without a sign-in.
    "health": { "path": "/api/config" }
  },
  // KV, D1, R2, Queues, Workflows, a SQLite-backed Durable Object (the click
  // buffer) and rate limiting all run on Workers Free, which upstream designs
  // for. Two cron triggers: a daily batch and a 10-minute outbox drain.
  "plan": "free",
  // Uploaded QR logos and avatars go to R2.
  "requires": ["r2"],
  "secrets": [
    {
      "name": "BETTER_AUTH_SECRET",
      "label": "Session signing secret",
      "help": "Signs sessions and tokens. Setting a new value signs everyone out.",
      "generate": "password"
    },
    {
      "name": "SUPERADMIN_EMAIL",
      "label": "Platform admin email",
      "help": "The account with this address becomes the platform admin (/admin), who can manage users and grant paid plans by hand."
    },
    {
      "name": "RESEND_API_KEY",
      "label": "Resend API key",
      "help": "From resend.com. Sign-up and password reset send a one-time code by email. Without it, sign-up needs no code and passwords cannot be reset by email, so set this or Google sign-in.",
      "link": { "label": "Get a key", "url": "https://resend.com/api-keys" },
      "optional": true
    },
    {
      "name": "CAP_SECRET",
      "label": "Proof-of-work secret",
      "help": "Signs the Cap proof-of-work challenge in front of sign-up and password reset; the check is skipped without it.",
      "generate": "password"
    },
    {
      "name": "GOOGLE_CLIENT_ID",
      "label": "Google OAuth client ID",
      "help": "With the secret below, for \"Continue with Google\". Authorized redirect URI: the app's address followed by /api/auth/callback/google.",
      "link": {
        "label": "Create an OAuth client",
        "url": "https://console.cloud.google.com/apis/credentials"
      },
      "optional": true
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "label": "Google OAuth client secret",
      "help": "The secret of the Google OAuth client above.",
      "link": {
        "label": "Create an OAuth client",
        "url": "https://console.cloud.google.com/apis/credentials"
      },
      "optional": true
    },
    {
      "name": "POLAR_ACCESS_TOKEN",
      "label": "Polar access token",
      "help": "Leave empty and every organization gets unlimited use. Set it only to sell the Hobby and Pro plans through Polar (scopes checkouts:write and customer_sessions:write), with the product ids below.",
      "link": { "label": "Create a token", "url": "https://polar.sh/docs/integrate/oat" },
      "optional": true
    },
    {
      "name": "POLAR_WEBHOOK_SECRET",
      "label": "Polar webhook secret",
      "help": "Signing secret of the Polar webhook pointed at the app's address followed by /api/webhooks/polar.",
      "link": {
        "label": "Add a webhook",
        "url": "https://polar.sh/docs/integrate/webhooks/endpoints"
      },
      "optional": true
    },
    {
      "name": "CF_API_TOKEN",
      "label": "Cloudflare token for custom domains",
      "help": "Lets organizations on a paid plan use their own domains through Cloudflare for SaaS: a token with Zone, SSL and Certificates, Edit on the zone below.",
      "optional": true,
      "cloudflareToken": true
    }
  ],
  // Every var the wrangler config sets names upstream's own deployment
  // (rdyrct.com, its mail domain, Polar products, zone and Sentry project),
  // so each one gets a default of this install's own, or an empty one.
  "vars": [
    {
      "name": "APP_URL",
      "label": "App URL",
      "help": "The address people open the app at, without a trailing slash. Sign-in only accepts requests from it, and emails link to it.",
      "default": "{{appUrl}}"
    },
    {
      // A bare hostname: upstream compares it with each request's Host header
      // (src/worker/index.ts) and puts https:// before it in shared short links.
      "name": "APP_HOST",
      "label": "Short link host",
      "help": "The host part of the App URL, without https://, such as go.example.com. Short links are shown under it, and organizations point their own domains at it.",
      "default": "{{appHostname}}"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "help": "Only with a Resend key: the From of sign-up and notification emails, at a domain verified in Resend, for example rdyrct <no-reply@mail.example.com>.",
      "default": "",
      "optional": true
    },
    {
      "name": "SENTRY_DSN",
      "label": "Sentry DSN",
      "help": "Your own Sentry project's DSN for Worker error reports. Leave it empty to send none.",
      "link": {
        "label": "Find your DSN",
        "url": "https://docs.sentry.io/concepts/key-terms/dsn-explainer/"
      },
      "default": "",
      "optional": true
    },
    {
      "name": "CF_ZONE_ID",
      "label": "Custom domains zone ID",
      "help": "The zone with Cloudflare for SaaS set up for customer domains.",
      "link": {
        "label": "Find your zone ID",
        "url": "https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/"
      },
      "default": "",
      "optional": true
    },
    {
      "name": "POLAR_SERVER",
      "label": "Polar environment",
      "type": "select",
      "options": [
        { "value": "production", "label": "Production" },
        { "value": "sandbox", "label": "Sandbox" }
      ],
      "default": "production",
      "optional": true
    },
    {
      "name": "POLAR_PRO_PRODUCT_ID",
      "label": "Polar Pro product ID",
      "help": "The recurring Pro product in your Polar organization.",
      "link": { "label": "Open the dashboard", "url": "https://polar.sh/dashboard" },
      "default": "",
      "optional": true
    },
    {
      "name": "POLAR_HOBBY_PRODUCT_ID",
      "label": "Polar Hobby product ID",
      "help": "The recurring Hobby product in your Polar organization.",
      "link": { "label": "Open the dashboard", "url": "https://polar.sh/dashboard" },
      "default": "",
      "optional": true
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{appUrl}} and sign up with the platform admin email. With a Resend key, the sign-up code arrives from the sender address you set. Without one, sign-up needs no code: set Resend or Google sign-in before you share the address."
    },
    {
      "type": "markdown",
      "content": "Without Polar, every organization has unlimited use and the billing pages are hidden. To sell the Hobby and Pro plans, set the Polar token, the webhook secret and both product ids in this app's settings."
    }
  ],
  "tokenPermissions": [
    {
      "group": "SSL and Certificates",
      "scope": "zone",
      "access": "edit",
      "reason": "Optional: lets organizations use their own domains through Cloudflare for SaaS."
    }
  ]
}
