{
  // This entry exists only to exercise the sandbox build path of the paid
  // tiers, and will be removed. It installs the same pinned commit as the
  // "flaremo" entry, built in the user's own account by the sandbox Worker
  // instead of by CI.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "flaremo-sandbox",
  "name": "FlareMo (sandbox build)",
  "summary": "A Memos-compatible notes app for quick capture: timeline, tags, attachments, semantic search, and an MCP server, on D1, R2, and Vectorize.",
  "homepage": "https://github.com/realchendahuang/FlareMo",
  "repo": "realchendahuang/FlareMo",
  "license": "AGPL-3.0-only",
  "categories": ["productivity", "notes"],
  "maintainers": ["MendyLanda"],
  "source": { "ref": "v0.20.1", "sha": "f87c98ee528848fb8c200ca538cd82d1db03505c" },
  "install": {
    "tier": "sandbox",
    "packageManager": "pnpm",
    // The button-ready config. Upstream's wrangler.jsonc is a local, untracked
    // copy of wrangler.jsonc.example; the optional site and Telegram bot
    // Workers under apps/ are separate deployments and are not installed.
    "wranglerConfig": "wrangler.json",
    "workerName": "flaremo-sandbox",
    // The wrangler config serves apps/web/dist but has no build.command;
    // upstream's deploy script builds the web app with this (tsc, then Vite).
    "buildCommand": "pnpm --filter @flaremo/web build",
    // An estimate, rounded up: the dependency install, then the web app's
    // type check and Vite build, on standard-1 (the default). Replace it
    // with a measured value after a live run.
    "sandbox": { "expectedMinutes": 8 },
    // Runs Worker code (the assets config sends it to the Worker first) and
    // needs no credentials: the OpenAPI document is built in code, without D1.
    "healthPath": "/openapi.json"
  },
  // The app itself fits the free plan (see the "flaremo" entry), but its build
  // runs in the sandbox Worker's container, which needs Workers Paid.
  "plan": "paid",
  // R2 has to be enabled on the account first. Workers AI computes the
  // embeddings for semantic search, the default provider.
  "requires": ["r2", "workers-ai"],
  // FLAREMO_RECOVERY_SECRET is a break-glass sign-in that upstream wants absent
  // except during a recovery, so it is not asked for. Set it in the Worker's
  // settings when you need it, and remove it afterwards.
  "secrets": [
    {
      "name": "BETTER_AUTH_SECRET",
      "label": "Session signing secret",
      "help": "Signs sign-in sessions and API tokens. At least 32 characters; changing it later signs everyone out.",
      "generate": true
    },
    {
      "name": "FLAREMO_BOOTSTRAP_SECRET",
      "label": "Setup secret",
      "help": "Creates the owner account once, on the /setup page. At least 32 characters. Copy it now.",
      "generate": true
    }
  ],
  // The embedding provider, model, dimensions, and Vectorize usage limits keep
  // the wrangler config's values: the indexes are created for that model.
  "vars": [
    {
      "name": "FLAREMO_PUBLIC_URL",
      "label": "Public URL",
      "help": "The address you will open the app at, without a path: https://<Worker name>.<your workers.dev subdomain>.workers.dev, or your custom domain. Sign-in only works from this origin, and it cannot be changed after installing.",
      // Newer managers fill in the Worker's workers.dev address here; older ones
      // show the placeholder as is, and it must be replaced by hand.
      "default": "{{workerUrl}}",
      "required": true
    },
    {
      "name": "FLAREMO_SINGLE_USER_NAME",
      "label": "Owner display name",
      "help": "Shown as the author of public memos and share pages until the owner sets a profile name.",
      "default": "FlareMo Owner",
      "required": false
    },
    {
      "name": "FLAREMO_TRUSTED_ORIGINS",
      "label": "Other trusted origins",
      "help": "Only when browsers reach the app from more origins than the public URL, for example a second custom domain. Comma separated, without paths.",
      "required": false
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{workerUrl}}/setup and enter the setup secret to create the owner account. The setup page works once; afterwards sign in at {{workerUrl}}."
    },
    {
      "type": "markdown",
      "content": "Sign-in works only at the public URL entered at install. Appflare cannot change it afterwards: an update sends the value from the install again, overwriting an edit made in the Cloudflare dashboard. If it is wrong, uninstall and install again with the right URL."
    },
    {
      "type": "markdown",
      "content": "Memos clients and scripts connect with a personal access token from Settings. MCP clients connect to {{workerUrl}}/mcp. The API is described at {{workerUrl}}/openapi.json."
    }
  ],
  "tokenPermissions": [],
  // Both indexes are created before the Worker is uploaded, and their shape
  // cannot change later. They match upstream's provisioning script: the
  // embedding model @cf/qwen/qwen3-embedding-0.6b returns 1024 dimensions, and
  // upstream creates both indexes with cosine distance.
  "resources": {
    "vectorize": {
      "VECTORIZE_MEMOS": { "dimensions": 1024, "metric": "cosine" },
      "VECTORIZE_MEMORIES": { "dimensions": 1024, "metric": "cosine" }
    }
  }
}
