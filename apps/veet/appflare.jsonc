{
  // Browser video calls on one Worker: static assets serve the app, and one
  // SQLite Durable Object per meeting relays WebRTC signalling over
  // hibernating WebSockets. Audio and video go peer to peer, never through
  // the Worker.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "veet",
  "name": "Veet",
  "summary": "Video calls in the browser: share a meeting link and talk face to face, with chat, device settings and peer-to-peer media for small groups.",
  "homepage": "https://github.com/megaconfidence/veet",
  "repo": "megaconfidence/veet",
  // The repository has no LICENSE file and states no licence in its README or
  // package.json.
  "license": "NONE",
  "categories": ["chat"],
  "authors": [
    {
      "name": "Confidence Okoghenun",
      "url": "https://confidence.sh",
      "github": "megaconfidence",
      "x": "megaconfidence"
    }
  ],
  "maintainers": ["MendyLanda"],
  // Upstream has no tags; the pin follows the default branch.
  "source": { "ref": "main", "sha": "cca7b6923040a502f873323db2edd3b56fa3681d" },
  "install": {
    "tier": "artifact",
    "packageManager": "npm",
    // Plain JavaScript and static files: no build step. The config declares the
    // Durable Object class with an `exports` block (SQLite storage) instead of
    // `migrations`; the artifact carries the block and the manager sends it
    // with the upload, as wrangler does.
    "wranglerConfig": "wrangler.jsonc",
    "workerName": "veet"
  },
  // A SQLite-backed Durable Object and static assets fit the free plan; the
  // optional TURN relay is billed by Cloudflare Realtime, with a free
  // allowance.
  "plan": "free",
  "requires": [],
  "secrets": [
    {
      "name": "TURN_KEY_ID",
      "label": "TURN key ID",
      "help": "From a TURN key in the Cloudflare dashboard under Realtime. Leave both TURN fields empty to connect with STUN only, which works on most home networks but not behind symmetric NAT or strict firewalls.",
      "optional": true
    },
    {
      "name": "TURN_KEY_API_TOKEN",
      "label": "TURN key API token",
      "help": "The API token shown with the TURN key above. The Worker uses it to hand each browser short-lived relay credentials; the token itself never reaches the browser.",
      "optional": true
    }
  ],
  "vars": [],
  "postInstall": [
    {
      "type": "markdown",
      "content": "Open {{workerUrl}}, start a meeting, and share its link. Anyone with the link can join, and calls work best with up to four or five people, since each browser sends its video to every other one."
    }
  ],
  "tokenPermissions": []
}
