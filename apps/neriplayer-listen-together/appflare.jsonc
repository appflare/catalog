{
  // The listen-together server of NeriPlayer, the Android music player: rooms
  // where a host and listeners keep playback, queue and settings in sync. One
  // SQLite Durable Object per room holds its state and the members'
  // hibernating WebSockets. Audio is never proxied; each phone plays on its
  // own.
  "$schema": "https://appflare.github.io/catalog/schema/v1.json",
  "slug": "neriplayer-listen-together",
  "name": "NeriPlayer Listen Together",
  "summary": "Your own listen-together server for the NeriPlayer Android app: create a room, share the invite, and everyone's playback, queue and track changes stay in sync.",
  "tagline": "Keep music playback in sync while listening with friends",
  "repo": "TheSmallHanCat/NeriPlayer-LTW",
  // The repository has no LICENSE file and states no licence in its README or
  // package.json. The NeriPlayer app, which includes it as a submodule, is
  // GPL-3.0, but that licence does not extend to this separate repository.
  "license": "NONE",
  "categories": ["media", "sync"],
  "authors": [{ "name": "TheSmallHanCat", "github": "TheSmallHanCat" }],
  "maintainers": ["MendyLanda"],
  // Upstream has no tags; the pin follows the default branch.
  "source": { "ref": "main", "sha": "d83f9e2f6b12d0f020fd23145ace10c71e3de777" },
  "install": {
    "packageManager": "npm",
    // Plain JavaScript: no build step.
    "wranglerConfig": "wrangler.toml",
    // Upstream's public health endpoint, answered by the Worker's own code.
    "health": { "path": "/healthz" }
  },
  // A SQLite-backed Durable Object fits the free plan.
  "plan": "free",
  "secrets": [
    {
      "name": "LISTEN_TOGETHER_TOKEN_SECRET",
      "label": "Room token secret",
      "help": "Signs the 24-hour tokens that let room members control playback and connect. Replacing it signs everyone out of open rooms.",
      "generate": "password"
    }
  ],
  "postInstall": [
    {
      "type": "markdown",
      "content": "In NeriPlayer, open Settings, go to the listen-together server settings, enter {{appUrl}}, and run the availability test. Then create a room or join one from an invite link."
    },
    {
      "type": "markdown",
      "content": "Anyone who knows the address can create rooms; joining a room needs its invite link."
    }
  ]
}
